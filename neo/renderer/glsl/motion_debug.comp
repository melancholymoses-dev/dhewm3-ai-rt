/*
===========================================================================

dhewm3-rt Vulkan — motion_debug.comp — r_fsrDebug 7 motion-vector overlay.

Nothing consumes the motion vectors until U3, so this pass is how U2 is
validated at all: it replaces hdrScene with a direction/speed picture of the
motionVectors attachment, at display resolution, just before the tonemap.

  hue   = flow direction, read off the colour wheel drawn in the top-left
  value = speed / motionScale, so a faster pixel is brighter
  near-black = no motion at all, which is what a parked camera must produce
               everywhere, and what sky/translucent pixels produce always
               (the prepass never writes them — see §13's coverage gap)

Motion vectors are stored in GL NDC (Y up).  The overlay converts to render
pixels so motionScale is a number you can reason about.

Descriptors (set 0):
  binding 0 — srcMotion sampler2D (motionVectors; texelFetch only — R16G16_SFLOAT is
              not a mandatory storage-image format, so it is bound as sampled)
  binding 1 — dstScene  rgba16f storage image (hdrScene)

Push constants (24 bytes, matches MotionDebugPC in vk_upscale.cpp):
  ivec2 renderExtent   — valid sub-rect of srcMotion
  ivec2 displayExtent  — size of dstScene
  float motionScale    — render pixels of motion that saturate
  float brightness     — output multiplier, so the tonemap doesn't crush it

FSR upscaling arc U2 — docs/plans/20260918_fsr_upscaling.md §13.

This file is a new addition with dhewm3-rt.  It was created with the aid of GenAI,
and may reference the existing Dhewm3 OpenGL and vkDoom3 Vulkan updates of the Doom 3 GPL Source
Code.

It is distributed under the same modified GNU General Public License Version 3 of the original Doom 3 GPL Source
Code release.

===========================================================================
*/

#version 460
layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D srcMotion;
layout(set = 0, binding = 1, rgba16f) uniform image2D dstScene;

layout(push_constant) uniform PC {
    ivec2 renderExtent;
    ivec2 displayExtent;
    float motionScale;
    float brightness;
} pc;

const int WHEEL_RADIUS = 36;

vec3 HueToRGB(float h)
{
    // h in [0,1), fully saturated; the caller applies value.  h = 0 is red.
    vec3 k = mod(h * 6.0 + vec3(0.0, 4.0, 2.0), 6.0);
    return clamp(abs(k - 3.0) - 1.0, 0.0, 1.0);
}

// Flow colour for a motion vector already converted to render pixels, Y up.
vec3 FlowColor(vec2 mvPix)
{
    float mag = length(mvPix);
    if (mag < 0.05)
        return vec3(0.02);   // "exactly zero" must be distinguishable from "slow"

    float hue = atan(mvPix.y, mvPix.x) / (2.0 * 3.14159265) + 0.5;
    float val = clamp(mag / max(pc.motionScale, 0.001), 0.0, 1.0);
    return HueToRGB(hue) * (0.15 + 0.85 * val);
}

void main()
{
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= pc.displayExtent.x || p.y >= pc.displayExtent.y)
        return;

    // The overlay runs after the resolve, so map display pixel -> render pixel.  At
    // render scale 1.0 this is the identity.
    ivec2 src = ivec2((vec2(p) + 0.5) * vec2(pc.renderExtent) / vec2(pc.displayExtent));
    src = clamp(src, ivec2(0), pc.renderExtent - 1);

    vec2 mvNdc = texelFetch(srcMotion, src, 0).xy;
    vec2 mvPix = mvNdc * 0.5 * vec2(pc.renderExtent);

    vec3 c = FlowColor(mvPix);

    // Legend: the same mapping over a full turn, so hue can be read as a direction
    // without guessing which way the wheel runs.
    ivec2 wheelCentre = ivec2(WHEEL_RADIUS + 8, WHEEL_RADIUS + 8);
    vec2 d = vec2(p - wheelCentre);
    // Screen Y is down, motion vectors are Y up — negate so "up on screen" and "up on
    // the wheel" are the same hue.
    d.y = -d.y;
    float r = length(d);
    if (r <= float(WHEEL_RADIUS))
        c = FlowColor(d * (pc.motionScale / float(WHEEL_RADIUS)));
    else if (r <= float(WHEEL_RADIUS) + 2.0)
        c = vec3(1.0);

    imageStore(dstScene, p, vec4(c * pc.brightness, 1.0));
}
