/*
===========================================================================

dhewm3-rt Vulkan — vol_march.comp — Volumetric light scattering.

Compute shader that ray-marches each view ray from the camera to the
depth-reconstructed hit point, firing GL_EXT_ray_query shadow tests toward
each in-range light at each step to accumulate single-scatter in-scattering.

Single-scattering model with Henyey-Greenstein phase function and
Beer-Lambert transmittance.  Exponential step distribution concentrates
samples near the camera where transmittance is highest.

Descriptors (set 0):
  binding 0 — TLAS                (ray queries for shadow tests)
  binding 1 — volBuf rgba16f      (output storage image)
  binding 2 — depthSampler        (reconstruct world position)
  binding 3 — VolParams UBO       (params)
  binding 4 — VolLightBuf SSBO   (vol's own light selection -- NOT GI's giLightSsbo.
                                   Built in vk_gi.cpp from the same admitted-candidate
                                   pool as GI, but filtered to lights that can possibly
                                   reach within r_rtVolMaxDist of the camera before GI's
                                   importance ranking ever runs, so a light admitted for
                                   GI/reflections purposes that can never appear in fog
                                   can't consume a slot here. See portal_area_lights.md
                                   follow-up notes.)

Phase 7.2 — Volumetric Lighting.

This file is a new addition with dhewm3-rt.  It was created with the aid of GenAI,
and may reference the existing Dhewm3 OpenGL and vkDoom3 Vulkan updates of the Doom 3 GPL Source
Code.

It is distributed under the same modified GNU General Public License Version 3 of the original Doom 3 GPL Source
Code release.

===========================================================================
*/

#version 460
#extension GL_EXT_ray_query : require

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

// ---------------------------------------------------------------------------
// Descriptors
// ---------------------------------------------------------------------------

layout(set = 0, binding = 0) uniform accelerationStructureEXT tlas;
layout(set = 0, binding = 1, rgba16f) uniform image2D volBuf;
layout(set = 0, binding = 2) uniform sampler2D depthSampler;

// std140 layout — offsets must match VolParamsUBO in vk_vol.cpp exactly.
layout(set = 0, binding = 3, std140) uniform VolParams {
    mat4  invViewProj;    // offset   0, size 64
    vec4  cameraPosW;     // offset  64, size 16  (xyz = camera world pos, w unused)
    uint  frameIndex;     // offset  80, size  4
    int   numSamples;     // offset  84, size  4
    int   maxLights;      // offset  88, size  4
    float density;        // offset  92, size  4
    float anisotropy;     // offset  96, size  4
    float maxDist;        // offset 100, size  4
    float strength;       // offset 104, size  4
    int   scissorOffsetX; // offset 108, size  4  (MARCH space — see marchScale)
    int   scissorOffsetY; // offset 112, size  4
    int   scissorExtentX; // offset 116, size  4
    int   scissorExtentY; // offset 120, size  4
    int   screenWidth;          // offset 124, size  4  (FULL res — depth buffer / NDC)
    int   screenHeight;         // offset 128, size  4
    float flashlightDensity;    // offset 132, size  4  (player flashlight, lightType 2)
    float flashlightAnisotropy; // offset 136, size  4
    float flashlightStrength;   // offset 140, size  4
    float directedDensity;      // offset 144, size  4  (scene spot/directed, lightType 1)
    float directedAnisotropy;   // offset 148, size  4
    float directedStrength;     // offset 152, size  4
    float _pad;                 // offset 156, size  4
    // --- P8: half-res march (rt_optimization_tuning.md) ---
    int   marchWidth;           // offset 160, size  4  volBuf dimensions (== full/marchScale)
    int   marchHeight;          // offset 164, size  4
    int   marchScale;           // offset 168, size  4  1 = full res, 2 = half res
    // Repurposed former pad float (was _pad2, always 0) — same offset, see
    // r_rtVolWhiteNoiseMix / the jitter blend below.
    float whiteNoiseMix;        // offset 172, size  4  0 = pure IGN, 1 = pure white noise
    // --- AR7 follow-up: muzzle-flash volumetric self-shadow (auto_relight.md) ---
    int   selfShadowEnable;     // offset 176, size  4  r_rtVolMuzzleSelfShadow
    int   selfShadowDebugMode;  // offset 180, size  4  r_rtVolMuzzleSelfShadowDebug
    float selfShadowBias;       // offset 184, size  4  r_rtVolMuzzleSelfShadowBias
    float _pad4;                // offset 188, size  4  std140 round to 16
} params;

// auto_relight.md AR7 follow-up: bit 0 marks the first-person muzzle-flash light (set
// CPU-side in vk_gi.cpp's considerLight — point light + allowLightInViewID). Used
// below to gate the self-shadow ray against player-body/weapon TLAS instances.
#define GI_LIGHT_FLAG_SELF_SHADOW 0x1u

struct GILight {
    vec4 posRadius;       // xyz = world position, w = sphere pre-cull radius
    vec4 colorIntensity;  // rgb = colour, a = intensity
    vec4 coneDir;         // projected: xyz=dir, w=cos(halfAngle); zeroed for point
    vec4 boxExtents;      // point: xyz=AABB half-extents, w=0; projected: w=max reach, xyz=0
    uint lightType;       // 0 = point, 1 = scene projected/spot, 2 = player flashlight
    uint flags;           // GI_LIGHT_FLAG_* (was an unused pad slot)
    uint _pad1; uint _pad2;
};

// GILightBuffer matches the C++ GILightBuffer struct (std430).
layout(set = 0, binding = 4, std430) readonly buffer GILightBuf {
    int    numLights;
    float  bounceScale;
    float  giRadius;
    float  emissiveScale;
    GILight lights[];
} giLightBuf;

// ---------------------------------------------------------------------------
// rt_indirect.glsl: provides wang_hash, randFloat, rt_ReconstructWorldPos.
// Requires: sampler2D depthSampler (declared above as binding 2).
// ---------------------------------------------------------------------------
#include "rt_indirect.glsl"

// ---------------------------------------------------------------------------
// Constants
// ---------------------------------------------------------------------------

#define VOL_SHADOW_BIAS 0.5

// ---------------------------------------------------------------------------
// Henyey-Greenstein phase function.
// cosTheta: dot(marchDir, toLightDir).
// g in [0,1): 0=isotropic, 0.5=forward-scatter flashlight, 0.8=shaft dust.
// ---------------------------------------------------------------------------
float HenyeyGreenstein(float cosTheta, float g)
{
    float g2    = g * g;
    float denom = 1.0 + g2 - 2.0 * g * cosTheta;
 
    return (1.0 - g2) / (4.0 * 3.14159265359 * pow(max(denom, 1e-2), 1.5));
}

// Cauchy-with-ramp attenuation — matches the GI bounce shading model.
float CauchyRamp(float dist, float radius)
{
    float x     = dist / max(radius, 0.001);
    float cauchy = 1.0 / (1.0 + x * x * 4.0);
    float ramp   = clamp(1.0 - x, 0.0, 1.0);
    return cauchy * ramp * ramp;
}

// ---------------------------------------------------------------------------
void main()
// ---------------------------------------------------------------------------
{
    ivec2 local      = ivec2(gl_GlobalInvocationID.xy);
    ivec2 scissorOff = ivec2(params.scissorOffsetX, params.scissorOffsetY);
    ivec2 scissorExt = ivec2(params.scissorExtentX, params.scissorExtentY);

    if (local.x >= scissorExt.x || local.y >= scissorExt.y)
        return;

    // P8: `coord` is in MARCH space (the volBuf image, full res / marchScale).
    // Depth and world-position reconstruction still happen at FULL res — we pick one
    // representative full-res texel per march pixel (the top-left of the marchScale²
    // quad).  vol_bilateral.comp uses the identical mapping when it upsamples, so the
    // depth it compares a tap against is exactly the depth that tap was marched from.
    ivec2 coord     = local + scissorOff;
    ivec2 marchSize = ivec2(params.marchWidth, params.marchHeight);
    if (coord.x >= marchSize.x || coord.y >= marchSize.y)
        return;

    ivec2 fullSize  = ivec2(params.screenWidth, params.screenHeight);
    ivec2 fullCoord = min(coord * params.marchScale, fullSize - ivec2(1));

    // Sky early-out: depth 1.0 means no geometry → nothing to scatter into.
    // Alpha = 1.0 (full transmittance, i.e. "no fog here") — NOT 0.0. Alpha now
    // carries path transmittance for a downstream background-attenuation
    // composite (see the end of this shader); 0.0 would mean "fully extinguish
    // whatever's behind this pixel", which is wrong for a no-fog/sky pixel.
    float depth = texelFetch(depthSampler, fullCoord, 0).r;
    if (depth >= 1.0)
    {
        imageStore(volBuf, coord, vec4(0.0, 0.0, 0.0, 1.0));
        return;
    }

    // Reconstruct world-space hit position and view ray direction.
    vec3 cameraPos = params.cameraPosW.xyz;
    vec3 hitPos    = rt_ReconstructWorldPos(fullCoord, fullSize, params.invViewProj);
    vec3 toHit     = hitPos - cameraPos;
    float hitDist  = length(toHit);

    if (hitDist < 0.001)
    {
        imageStore(volBuf, coord, vec4(0.0, 0.0, 0.0, 1.0)); // see sky early-out above re: alpha
        return;
    }

    vec3  marchDir = toHit / hitDist;
    float tMax     = min(hitDist, params.maxDist);

    // Spatial-coherence jitter (tried against wang_hash per-pixel noise, which
    // decorrelates every pixel from its neighbors by design — the direct cause
    // of volumetric beams reading as noise instead of one coherent shape, since
    // neighboring pixels along what should be a single beam were sampling at
    // unrelated fractional offsets along their own march).
    //
    // Interleaved Gradient Noise (Jimenez) instead: spatially correlated within
    // a frame — nearby pixels get nearly the same jitter phase — but still
    // well-distributed in aggregate. A per-frame golden-ratio rotation (same
    // idiom as shadow_ray.rgen's phiOffset, Fix 2) varies the pattern frame to
    // frame so the temporal EMA keeps converging instead of locking onto one
    // static dither. Confirmed >6 samples improves shaft quality noticeably,
    // 64 did little — consistent with decorrelation (not step count) having
    // been the limiter.
    //
    // IGN's regularity is a double-edged sword: it fixed the "beams read as
    // noise" problem, but the same fixed diagonal grid is visible as striping/
    // fringing along march edges once the eye locks onto the pattern. Blend in
    // a little decorrelated white noise (wang_hash, same per-pixel/per-frame
    // seed idiom as the RT bounce shaders) to soften the grid without fully
    // reintroducing beam decorrelation — r_rtVolWhiteNoiseMix controls how much.
    float ign   = fract(52.9829189 * fract(dot(vec2(coord), vec2(0.06711056, 0.00583715))));
    float white = randFloat(wang_hash(uint(coord.x) * 1973u ^ wang_hash(uint(coord.y) * 9277u) ^
                                       wang_hash(params.frameIndex * 26699u)));
    float jitter = fract(mix(ign, white, params.whiteNoiseMix) + float(params.frameIndex) * 0.6180339887);

    int   numSteps = max(1, params.numSamples);
    float logFac   = log(tMax + 1.0);
    int   maxLights = min(params.maxLights, giLightBuf.numLights);

    vec3  scatter_point    = vec3(0.0); // lightType 0: point lights
    vec3  scatter_directed = vec3(0.0); // lightType 1: scene directed/spot lights
    vec3  scatter_flash    = vec3(0.0); // lightType 2: player flashlight
    float transmittance    = 1.0;

    for (int s = 0; s < numSteps; s++)
    {
        // Exponential step distribution: samples concentrate near the camera
        // where transmittance is highest and contribution is greatest.
        float alphaA = clamp((float(s) + jitter) / float(numSteps), 0.0, 1.0);
        float alphaB = clamp( float(s + 1)        / float(numSteps), 0.0, 1.0);
        float tA     = clamp(exp(alphaA * logFac) - 1.0, 0.0, tMax);
        float tB     = clamp(exp(alphaB * logFac) - 1.0, 0.0, tMax);

        float stepT    = (tA + tB) * 0.5;
        float stepSize = max(tB - tA, 1e-4);

        // Beer-Lambert: update running transmittance and bail when negligible.
        float transBefore = transmittance;
        transmittance *= exp(-params.density * stepSize);
        if (transmittance < 0.001)
            break;

        // Self-attenuation fix (2026-08-23 — reported as a general volumetric
        // brightness "lift"): light scattered at this step still has to travel
        // back through every step of medium between here and the camera before
        // it reaches the eye. Every step below was previously added at full
        // strength regardless of how much medium sat between it and the
        // camera — `transmittance` was computed and used only for the
        // early-exit check above, never applied to the accumulated contribution.
        // That's a straight energy-conservation bug: a beam through N steps of
        // fog summed N un-attenuated contributions instead of a properly
        // decaying series, which reads as a flat brightness lift rather than a
        // shaped beam. Geometric mean of before/after transmittance
        // approximates the transmittance AT stepPos (the step's midpoint,
        // matching stepT above) rather than at either endpoint.
        float stepTransmittance = sqrt(transBefore * transmittance);

        vec3 stepPos = cameraPos + marchDir * stepT;

        // Evaluate up to `maxLights` entries of vol's own light selection (binding 4)
        // at this step position -- already pre-filtered CPU-side to lights that can
        // possibly reach within r_rtVolMaxDist of the camera and importance-ordered,
        // see portal_area_lights.md follow-up notes.
        for (int li = 0; li < maxLights; li++)
        {
            vec3  lightPos    = giLightBuf.lights[li].posRadius.xyz;
            float sphereRad   = giLightBuf.lights[li].posRadius.w;
            vec3  lightColor  = giLightBuf.lights[li].colorIntensity.rgb;
            float lightIntens = giLightBuf.lights[li].colorIntensity.a;
            if (lightIntens < 0.001) lightIntens = 1.0;

            uint  lt           = giLightBuf.lights[li].lightType;
            bool  isFlashlight = (lt == 2u);
            bool  isDirected   = (lt == 1u);
            vec4  cd           = giLightBuf.lights[li].coneDir;
            vec4  bx           = giLightBuf.lights[li].boxExtents;

            vec3  toLight = lightPos - stepPos;
            float dist    = length(toLight);

            // Sphere pre-cull: fast reject before precise containment test.
            if (dist > sphereRad)
                continue;

            // Precise volume containment + attenuation.
            // Point lights (lt==0) use bounding-box containment.
            // Projected lights (lt==1 directed, lt==2 flashlight) use cone containment.
            float atten;
            if (lt == 0u)
            {
                // Point light: box-normalized L∞ distance (1.0 = face, 1.5 = outer limit).
                vec3  localAbs  = abs(stepPos - lightPos);
                vec3  normLocal = localAbs / max(bx.xyz, vec3(0.001));
                float maxNorm   = max(max(normLocal.x, normLocal.y), normLocal.z);

                if (maxNorm >= 1.5) continue;

                if (maxNorm <= 1.0)
                    atten = mix(0.1, 1.0, clamp((1.0 - maxNorm) / 0.2, 0.0, 1.0));
                else
                    atten = 0.1 * clamp((1.5 - maxNorm) / 0.5, 0.0, 1.0);

                // Fade to zero at the light origin to prevent singularity glow blob.
                // The innermost 15% of the sphere radius is where the march step
                // is so close to the origin that phase/direction noise amplifies
                // into a visible bright sphere centred on the light entity.
                float coreFade = smoothstep(0.0, sphereRad * 0.15, dist);
                atten *= coreFade;
            }
            else
            {
                // Projected light (scene directed lt==1, or flashlight lt==2): cone containment.
                vec3  toStep    = stepPos - lightPos;
                float alongCone = dot(toStep, cd.xyz);
                if (alongCone <= 0.0 || alongCone > bx.w)
                    continue;
                float cosAngle = alongCone / max(length(toStep), 0.001);
                if (cosAngle < cd.w)
                    continue;
                atten = clamp(1.0 - alongCone / max(bx.w, 0.001), 0.0, 1.0);
            }

            if (atten < 0.001)
                continue;

            vec3  lightDir = toLight / max(dist, 0.001);
            float cosTheta = dot(marchDir, lightDir);

            float localAniso = isFlashlight ? params.flashlightAnisotropy
                             : isDirected   ? params.directedAnisotropy
                                            : params.anisotropy;
            float phase        = HenyeyGreenstein(cosTheta, localAniso);

            // Fire a ray query to test occlusion between stepPos and the light.
            float tShadow = max(0.01, dist - VOL_SHADOW_BIAS);

            // AR7 follow-up (auto_relight.md): the muzzle flash is the one volumetric
            // light with real self-shadow potential (it sits on the gun, with parallax,
            // unlike the eye-mounted flashlight — see the doc's "why interesting" note).
            // Every other light keeps the original unconditional player-body exclusion.
            bool selfShadowEligible = (giLightBuf.lights[li].flags & GI_LIGHT_FLAG_SELF_SHADOW) != 0u;
            bool selfShadowOn       = selfShadowEligible && (params.selfShadowEnable != 0);

            uint  cullMask   = selfShadowOn ? 0xFFu : 0xFEu;
            // A muzzle flash sits only a few units from its own gun mesh — much closer
            // than tShadow usually is — so tMin needs a real bias, not the default 0.01,
            // to avoid re-intersecting the same geometry the ray just launched from.
            // Clamped below tShadow so the ray stays non-degenerate.
            float shadowTMin = selfShadowOn ? clamp(params.selfShadowBias, 0.01, max(0.01, tShadow - 0.001))
                                             : 0.01;

            rayQueryEXT rq;
            rayQueryInitializeEXT(
                rq, tlas,
                gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsOpaqueEXT,
                cullMask,  // 0xFE skips player body/hands (mask 0x01); 0xFF (self-shadow-on) tests it too
                stepPos, shadowTMin, lightDir, tShadow);

            while (rayQueryProceedEXT(rq))
            {
                if (rayQueryGetIntersectionTypeEXT(rq, false) ==
                    gl_RayQueryCandidateIntersectionTriangleEXT)
                    rayQueryConfirmIntersectionEXT(rq);
            }

            bool occluded = (rayQueryGetIntersectionTypeEXT(rq, true) !=
                              gl_RayQueryCommittedIntersectionNoneEXT);

            // AR7 debug view: independent of r_rtVolMuzzleSelfShadow, fire a SECOND query
            // restricted to player-body/weapon geometry only (mask 0x01), and tint any hit
            // hot magenta. This isolates the self-shadow signal from ordinary world
            // occlusion so the hit pattern (clean silhouette vs. acne flicker) can be
            // judged before enabling or tuning the real feature.
            if (selfShadowEligible && params.selfShadowDebugMode != 0)
            {
                float debugTMin = clamp(params.selfShadowBias, 0.01, max(0.01, tShadow - 0.001));
                rayQueryEXT rqSelf;
                rayQueryInitializeEXT(
                    rqSelf, tlas,
                    gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsOpaqueEXT,
                    0x01u, // player body/hands ONLY
                    stepPos, debugTMin, lightDir, tShadow);
                while (rayQueryProceedEXT(rqSelf))
                {
                    if (rayQueryGetIntersectionTypeEXT(rqSelf, false) ==
                        gl_RayQueryCandidateIntersectionTriangleEXT)
                        rayQueryConfirmIntersectionEXT(rqSelf);
                }
                if (rayQueryGetIntersectionTypeEXT(rqSelf, true) !=
                    gl_RayQueryCommittedIntersectionNoneEXT)
                    scatter_point += vec3(4.0, 0.0, 4.0) * stepSize * stepTransmittance;
            }

            if (occluded)
                continue; // occluded — skip this light at this step

            vec3 contrib = lightColor * lightIntens * phase * atten * stepSize * stepTransmittance;
            if (isFlashlight)
                scatter_flash    += contrib;
            else if (isDirected)
                scatter_directed += contrib;
            else
                scatter_point    += contrib;
        }
    }

    // Combine three light classes with independent density/strength controls.
    // Beer-Lambert transmittance uses global density; these multipliers tune each type.
    vec3 result = max(
        scatter_point    * params.density          * params.strength          +
        scatter_directed * params.directedDensity  * params.directedStrength  +
        scatter_flash    * params.flashlightDensity * params.flashlightStrength,
        vec3(0.0));

    // Clamp well under the fp16 (rgba16f) ceiling to avoid Inf.
    result = min(result, vec3(4096.0));

    // Alpha carries the total path transmittance (camera -> tMax): 1.0 = clear
    // air, near-0.0 = the view ray is fully extinguished by the medium before
    // it reaches the surface. Not yet consumed by vol_composite.frag's blend
    // state (still pure additive) — that would also need the composite call
    // moved to after the direct-lighting interaction pass so it attenuates
    // ALL scene radiance behind the fog, not just the GI/reflection base drawn
    // before it; tracked as a follow-up, not done here. Plumbed through now
    // (bilateral upsample and temporal EMA already carry all 4 channels) so
    // it's available without another pass of shader surgery, and so it can be
    // inspected directly (e.g. temporarily view volBuf.a) to sanity-check the
    // self-attenuation fix above.
    imageStore(volBuf, coord, vec4(result, transmittance));
}
