/*
===========================================================================

dhewm3-rt Vulkan — gi_probe_resolve.comp — probe atlas -> screen.

Writes vkRT.giBuffer and vk_gi_probe.cpp repoints giReadView at it, so
gi_composite.frag keeps sampling one 2D image and knows nothing about probes.

  mode 0 — the real resolve (G2).  Reconstruct the pixel's world position and
           shading normal, offset along the normal, then take the 8 lattice
           probes surrounding that point: trilinear weight x a wrapped cosine
           term against the direction to each probe, normalised.  The atlas
           fetch direction is the NORMAL (irradiance arriving from the
           hemisphere); the probe direction only weights the blend.

  mode 1 — probe spheres tinted by the irradiance they have stored, in the
           direction the sphere is seen from.  This is the convergence readout
           for G1: a probe in a red-lit room must read red within ~16 frames.
  mode 4 — probe state.  green = traced since it entered the window,
           red = never traced (its atlas tile is stale or empty and the G2
           resolve must fall back rather than darken), blue = classified inside
           geometry (G4).
  mode 5 — distance atlas readout, owed from G1 (nothing had ever looked at
           the visibility moments and G3's Chebyshev test is built on them).
           Spheres are tinted by the stored mean — already normalised to
           [0,1] by maxRayDist — on a blue->green->red ramp; magenta means
           mean2 < mean^2, which is algebraically impossible for a real second
           moment and therefore says the lobe or the EMA is wrong, not merely
           mistuned.

The sphere overlays ADD onto the lit scene rather than replacing it: the thing
being checked is where the probes sit in the world, and a black background
makes that much harder to judge than the room around them does.

Descriptors (set 0):
  binding 0 — irradiance atlas (sampler2D)
  binding 1 — giBuffer rgba16f 2D (write)
  binding 2 — GIProbeParams UBO       (declared by gi_probe_common.glsl)
  binding 3 — probe state SSBO        (declared by gi_probe_common.glsl)
  binding 4 — distance atlas (sampler2D)
  binding 5 — depthSampler
  binding 6 — gbufNormalSampler

20260906_froxel_probe_gi.md Part B, chunks G0-G2.

This file is a new addition with dhewm3-rt.  It was created with the aid of GenAI,
and may reference the existing Dhewm3 OpenGL and vkDoom3 Vulkan updates of the Doom 3 GPL Source
Code.

It is distributed under the same modified GNU General Public License Version 3 of the original Doom 3 GPL Source
Code release.

===========================================================================
*/

#version 460

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D irradianceAtlas;
layout(set = 0, binding = 1, rgba16f) uniform image2D giOut;
layout(set = 0, binding = 4) uniform sampler2D distanceAtlas;
layout(set = 0, binding = 5) uniform sampler2D depthSampler;
layout(set = 0, binding = 6) uniform sampler2D gbufNormalSampler;

#define GIPROBE_SET 0
#include "gi_probe_common.glsl"
// Satisfies rt_indirect.glsl's includer contract (a sampler2D named
// depthSampler, declared above).
#include "rt_indirect.glsl"
#include "rt_gbuf_normal.glsl"

// ---------------------------------------------------------------------------
// Ray vs the probe lattice.
//
// Stepping the ray and testing the NEAREST lattice point at each step, rather
// than iterating the whole grid: at spacing/2 steps no sphere of radius <
// spacing/2 can be stepped over, and each test is an analytic ray-sphere so the
// result is exact rather than a marched approximation.
// ---------------------------------------------------------------------------
bool gip_TraceProbeSphere(vec3 ro, vec3 rd, float tMax, float radius, out ivec3 hitCell, out vec3 hitNormal)
{
    hitCell = ivec3(0);
    hitNormal = vec3(0.0);

    float spacing = max(gp.gridOrigin.w, 1.0);
    float step = spacing * 0.5;
    float r2 = radius * radius;
    float best = tMax;
    bool found = false;

    // 256 steps * spacing/2 covers 8192 units at the 64-unit default, well past
    // any Doom 3 room; the loop exits on tMax long before that indoors.
    for (int i = 0; i < 256; i++)
    {
        float t = float(i) * step;
        if (t > tMax)
            break;

        vec3 p = ro + rd * t;
        ivec3 cell = ivec3(round(p / spacing));
        if (!gip_CellInGrid(cell))
            continue;

        vec3 c = gip_ProbePos(cell);
        vec3 oc = c - ro;
        float tca = dot(oc, rd);
        float d2 = dot(oc, oc) - tca * tca;
        if (d2 > r2)
            continue;

        float t0 = tca - sqrt(max(0.0, r2 - d2));
        if (t0 < 0.0 || t0 >= best)
            continue;

        best = t0;
        hitCell = cell;
        hitNormal = normalize((ro + rd * t0) - c);
        found = true;
    }

    return found;
}

// Blue -> cyan -> green -> yellow -> red over [0,1].  Overlay-only.
vec3 gip_Ramp(float t)
{
    t = clamp(t, 0.0, 1.0);
    return clamp(vec3(t * 3.0 - 1.5, 1.5 - abs(t * 3.0 - 1.5), 1.5 - t * 3.0), vec3(0.0), vec3(1.0));
}

// ---------------------------------------------------------------------------
// The G2 resolve: irradiance at (worldPos, normal) from the 8 surrounding
// probes.  Returns false when not one of them has usable data — the caller
// must leave GI at zero rather than invent a value, and that case is what
// debug mode 4's red spheres locate.
// ---------------------------------------------------------------------------
bool gip_SampleIrradiance(vec3 worldPos, vec3 normal, out vec3 irradiance)
{
    irradiance = vec3(0.0);

    float spacing = max(gp.gridOrigin.w, 1.0);
    vec3 samplePos = worldPos + normal * max(gp.tune.y, 0.0);

    // The lattice is absolute, so the base cell is a plain floor of the world
    // position in lattice units — no grid origin enters the arithmetic.
    vec3 g = samplePos / spacing;
    ivec3 baseCell = ivec3(floor(g));
    vec3 frac = clamp(g - vec3(baseCell), vec3(0.0), vec3(1.0));

    vec3 sum = vec3(0.0);
    float sumW = 0.0;

    for (int i = 0; i < 8; i++)
    {
        ivec3 off = ivec3(i & 1, (i >> 1) & 1, (i >> 2) & 1);
        ivec3 cell = baseCell + off;
        if (!gip_CellInGrid(cell))
            continue;

        int idx = gip_StorageIndex(cell);
        uint flags = probeState.probes[idx].flags;
        // An untraced probe's atlas tile still belongs to whichever probe last
        // occupied it (storage is toroidal), so it is not "black", it is
        // another room — exclude it outright.
        if ((flags & GIPROBE_FLAG_TRACED) == 0u)
            continue;
        if ((flags & GIPROBE_FLAG_INSIDE) != 0u)
            continue;

        vec3 tri = mix(vec3(1.0) - frac, frac, vec3(off));
        float weight = tri.x * tri.y * tri.z;
        if (weight <= 0.0)
            continue;

        // Wrapped cosine against the true (unbiased) direction to the probe:
        // a probe behind the surface contributes almost nothing, but never
        // exactly nothing, or the interpolation goes discontinuous at grazing
        // angles and shows as banding.
        vec3 toProbe = gip_ProbePos(cell) - worldPos;
        float lenSq = dot(toProbe, toProbe);
        vec3 dirToProbe = (lenSq > 1e-8) ? (toProbe * inversesqrt(lenSq)) : normal;
        float wrapped = max(1e-4, (dot(dirToProbe, normal) + 1.0) * 0.5);
        weight *= wrapped * wrapped + 0.2;

        // Crush the tail so a probe contributing a sliver does not drag a
        // neighbouring room's colour in at full trilinear strength.
        const float crush = 0.2;
        if (weight < crush)
            weight *= (weight * weight) / (crush * crush);

        vec2 auv = gip_AtlasUV(idx, normal, gp.atlas.z);
        sum += texture(irradianceAtlas, auv).rgb * weight;
        sumW += weight;
    }

    if (sumW <= 1e-6)
        return false;

    irradiance = sum / sumW;
    return true;
}

void main()
{
    ivec2 local = ivec2(gl_GlobalInvocationID.xy);
    ivec2 rectOff = gp.rect.xy;
    ivec2 rectExt = gp.rect.zw;
    if (local.x >= rectExt.x || local.y >= rectExt.y)
        return;

    ivec2 coord = local + rectOff;
    ivec2 outSize = gp.screen.zw;
    if (coord.x >= outSize.x || coord.y >= outSize.y)
        return;

    int mode = gp.misc.x;
    ivec2 fullSize = gp.screen.xy;
    ivec2 fullCoord = min(coord, fullSize - ivec2(1));

    vec3 outColour = vec3(0.0);

    if (mode == 0)
    {
        float depth = texelFetch(depthSampler, fullCoord, 0).r;
        if (depth < 1.0) // sky and unwritten pixels get no GI, same as gi_ray.rgen
        {
            vec3 worldPos = rt_ReconstructWorldPos(fullCoord, fullSize, gp.invViewProj);
            vec3 toEye = gp.cameraPosW.xyz - worldPos;
            vec3 viewDir = (dot(toEye, toEye) > 1e-8) ? normalize(toEye) : vec3(0.0, 0.0, 1.0);

            vec3 normal;
            if (!rt_GbufNormalAt(fullCoord, gp.misc.y, viewDir, normal))
                normal = rt_ReconstructNormal(fullCoord, fullSize, gp.invViewProj, worldPos, viewDir);

            vec3 irradiance;
            if (gip_SampleIrradiance(worldPos, normal, irradiance))
            {
                outColour = irradiance * gp.tune.z;

                // Same energy-neutral contrast push gi_ray.rgen applies, so an
                // r_rtGIProbes A/B at matched r_rtGIStrength/r_rtGIContrast
                // compares the sampling structure and nothing else.
                if (gp.tune2.x > 0.0)
                {
                    vec3 grayRef = vec3(dot(outColour, vec3(1.0 / 3.0)));
                    outColour = max(grayRef + (outColour - grayRef) * (1.0 + gp.tune2.x), vec3(0.0));
                }
            }
        }
    }
    else if (mode == 1 || mode == 4 || mode == 5)
    {
        vec2 uv = (vec2(fullCoord) + 0.5) / vec2(fullSize);
        vec3 ro = gp.cameraPosW.xyz;
        vec3 rd = gip_RayDirForUV(uv);

        // Spheres are occluded by the world: a probe behind a wall must not show
        // through it, or the overlay reads as "probes everywhere" and says
        // nothing about placement.
        float depth = texelFetch(depthSampler, fullCoord, 0).r;
        float tMax = 1.0e6;
        if (depth < 1.0)
            tMax = length(rt_ReconstructWorldPos(fullCoord, fullSize, gp.invViewProj) - ro);

        ivec3 cell;
        vec3 n;
        if (gip_TraceProbeSphere(ro, rd, tMax, max(gp.debug.y, 0.25), cell, n))
        {
            int idx = gip_StorageIndex(cell);
            uint flags = probeState.probes[idx].flags;

            if (mode == 4)
            {
                if ((flags & GIPROBE_FLAG_INSIDE) != 0u)
                    outColour = vec3(0.0, 0.3, 1.0);
                else if ((flags & GIPROBE_FLAG_TRACED) != 0u)
                    outColour = vec3(0.0, 1.0, 0.0);
                else
                    outColour = vec3(1.0, 0.0, 0.0);

                // Cheap lambert against the view so the spheres read as spheres
                // and a lattice is legible as a lattice.
                outColour *= mix(0.35, 1.0, max(0.0, dot(n, -rd)));
            }
            else if (mode == 5)
            {
                if ((flags & GIPROBE_FLAG_TRACED) == 0u)
                {
                    outColour = vec3(0.4, 0.0, 0.4);
                }
                else
                {
                    // Both moments are already normalised by maxRayDist — see
                    // gi_probe_blend.comp's header for why they have to be.
                    vec2 m = texture(distanceAtlas, gip_AtlasUV(idx, n, gp.atlas.w)).rg;
                    // Negative variance cannot happen for a real second moment;
                    // if it does, the lobe weights or the EMA are wrong, not
                    // merely mistuned.  Catches an fp16 overflow as NaN too.
                    if (!(m.y >= m.x * m.x - 1e-3))
                        outColour = vec3(1.0, 0.0, 1.0);
                    else
                        outColour = gip_Ramp(m.x);
                    outColour *= mix(0.35, 1.0, max(0.0, dot(n, -rd)));
                }
            }
            else
            {
                vec2 auv = gip_AtlasUV(idx, n, gp.atlas.z);
                outColour = texture(irradianceAtlas, auv).rgb * gp.debug.x;

                // An untraced probe has nothing to show; magenta says "no data"
                // rather than letting a black tile read as "this room is dark".
                if ((flags & GIPROBE_FLAG_TRACED) == 0u)
                    outColour = vec3(0.4, 0.0, 0.4);
            }
        }
    }

    imageStore(giOut, coord, vec4(max(outColour, vec3(0.0)), 1.0));
}
