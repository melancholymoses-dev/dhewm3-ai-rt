#version 460

// ---------------------------------------------------------------------------
// shadow_blur.comp  —  Separable Gaussian blur for the shadow mask
//
// Dispatched twice per light: once horizontal (direction=0), once vertical (direction=1).
// Reads from inputImage, writes to outputImage.
//
// P1b: both images are 2D arrays with one layer per shadow-casting light.  Each
// dispatch operates on a single layer (`layer` push constant) over that light's
// scissor rect, so all lights' H passes can be recorded back-to-back with no
// barriers between them — they touch disjoint layers.
// ---------------------------------------------------------------------------

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, r8) uniform readonly  image2DArray inputImage;
layout(set = 0, binding = 1, r8) uniform writeonly image2DArray outputImage;
layout(set = 0, binding = 2) uniform sampler2D depthSampler;

layout(push_constant) uniform BlurParams {
    int   direction;   // 0 = horizontal, 1 = vertical
    int   radius;      // kernel half-width in pixels (e.g. 3 means 7-tap)
    float depthThreshold;
    float depthAware;  // >0.5 enables depth-aware weighting
    ivec2 scissorOffset;
    ivec2 scissorExtent;
    int   layer;       // shadow mask array layer for this light
};

void main() {
    ivec2 localCoord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size  = imageSize(inputImage).xy;
    ivec2 rectExtent = max(scissorExtent, ivec2(0));

    if (localCoord.x >= rectExtent.x || localCoord.y >= rectExtent.y)
        return;

    ivec2 coord = localCoord + scissorOffset;

    if (coord.x >= size.x || coord.y >= size.y)
        return;

    ivec2 rectMin = max(scissorOffset, ivec2(0));
    ivec2 rectMax = min(scissorOffset + rectExtent - ivec2(1), size - ivec2(1));

    if (coord.x < rectMin.x || coord.y < rectMin.y || coord.x > rectMax.x || coord.y > rectMax.y)
        return;

    // Gaussian weights (precomputed for sigma ≈ radius/2)
    // We use a simple triangular/tent approximation for speed:
    //   weight(i) = (radius + 1 - abs(i)) / sum
    // This is visually close to Gaussian and avoids exp() in shader.
    float sum   = 0.0;
    float total = 0.0;
    int r = max(radius, 0);
    float centerDepth = texelFetch(depthSampler, coord, 0).r;

    ivec2 step = (direction == 0) ? ivec2(1, 0) : ivec2(0, 1);

    for (int i = -r; i <= r; i++) {
        ivec2 sampleCoord = coord + step * i;

        // Clamp to this light/view dispatch rect to avoid cross-light and cross-mirror bleed.
        sampleCoord = clamp(sampleCoord, rectMin, rectMax);

        float w = float(r + 1 - abs(i));
        if (depthAware > 0.5) {
            float sampleDepth = texelFetch(depthSampler, sampleCoord, 0).r;
            float dz = abs(sampleDepth - centerDepth);
            float th = max(depthThreshold, 1e-6);

            // Soft edge-aware weighting avoids quantized banding from hard reject.
            // 1.0 at dz<=th, smoothly fades to 0.0 by dz>=2*th.
            float edgeW = 1.0 - smoothstep(th, th * 2.0, dz);
            w *= edgeW;

            if (w <= 1e-5) {
                continue;
            }
        }
        float val = imageLoad(inputImage, ivec3(sampleCoord, layer)).r;
        sum   += val * w;
        total += w;
    }

    float centerVal = imageLoad(inputImage, ivec3(coord, layer)).r;
    float result = (total > 0.0) ? (sum / total) : centerVal;
    imageStore(outputImage, ivec3(coord, layer), vec4(result));
}
