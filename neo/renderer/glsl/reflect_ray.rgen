/*
===========================================================================

dhewm3-rt Vulkan — Reflection ray generation shader.

For every non-sky pixel:
  0. Sample the G-buffer normal/F0 (Stage 3.5, see docs/plans/gbuffer_normal_pass.md)
     written by the depth prepass. r_rtReflectionDebugMode 2/3/4 short-circuit here
     to visualize it directly, before any ray tracing.
  1. Reconstruct world-space position and the mirror-reflected view direction.
     Early-out on pixels with no glass in front and F0 ~ 0 (skips the reflect
     ray + shadow rays — the perf win this buffer exists for).
  2. Compute the Schlick Fresnel term ONCE per pixel (not per-light, the bug
     this whole effort exists to fix — see Step 8) using the bump-mapped
     shading normal (not the flat geometric normal rt_ReconstructNormal derives
     from depth gradients). R1: this happens BEFORE the trace, and a pixel whose
     weight lands under r_rtReflectionMinWeight returns here — an exact cull,
     since nothing in the weight depends on the trace result. R2: the grazing
     ceiling scales with F0 (r_rtSpecGrazingGain) rather than being a flat
     r_rtSpecGrazingMax for every rough surface, which is what kept near-matte
     geometry both expensive and visibly sheened.
  3. Trace rays using a short bounce loop (max 2 iterations).
     - On an opaque hit, rchit writes colour + transmittance=0 → stop.
     - On a glass hit, rchit writes F0*tint + transmittance=0.96 + nextOrigin/Dir
       so the loop fires a continuation ray straight through the glass.
     - On a miss, rmiss writes sky colour + transmittance=0 → stop.
  4. Write the Fresnel-weighted radiance to the reflection RGBA16F buffer.
     Glass pixels are the exception: they store raw
     radiance + glassWeight in NEGATED alpha, a sentinel telling
     refl_composite.frag to skip them — they're composited separately by
     glass_refl_overlay.frag, since the depth/G-buffer at a glass pixel belongs
     to the unrelated opaque surface behind the glass.

refl_composite.frag additively blends non-glass pixels onto the framebuffer
once per view (replacing the disabled per-light reflection block in
interaction.frag). glass_refl_overlay.frag composites glass pixels separately,
once per MC_TRANSLUCENT surface.

This file is a new addition with dhewm3-rt.  It was created with the aid of GenAI, and
may reference the existing Dhewm3 OpenGL and vkDoom3 Vulkan updates of the Doom 3 GPL Source Code.

It is distributed under the same modified GNU General Public License Version 3
of the original Doom 3 GPL Source Code release.

===========================================================================
*/

#version 460
#extension GL_EXT_ray_tracing : require

layout(set = 0, binding = 0) uniform accelerationStructureEXT topLevelAS;
layout(set = 0, binding = 1, rgba16f) uniform image2D reflImage;
layout(set = 0, binding = 2) uniform sampler2D depthSampler;
// G-buffer normal/F0 (Stage 3.5): rgb = world normal * 0.5 + 0.5, a = F0.
// a == 0 means "no usable normal" (gbufferSupported false, sky/translucent
// geometry, or a surface whose specular map remaps to F0 == 0) — fall back to
// rt_ReconstructNormal; rgb at the 0.5 clear sentinel means the prepass never
// wrote the pixel at all (debug mode 4 tests this). Sampled with texelFetch, so the bound
// sampler's filter/wrap state is irrelevant; always valid (real image when
// vk.gbufferSupported, a 1x1 null image with a=0 otherwise — see VK_RT_DispatchReflections).
layout(set = 0, binding = 5) uniform sampler2D gbufNormalSampler;

layout(set = 0, binding = 3) uniform ReflParams {
    mat4   invViewProj;
    float  maxDist;
    uint   frameIndex;
    ivec2  screenSize;
    float  reflBlend;     // r_rtReflectionBlend — scale baked in at imageStore time
    float  grazingMax;    // r_rtSpecGrazingMax — grazing-angle Fresnel clamp (Step 8)
    int    debugMode;     // r_rtReflectionDebugMode — 2/3/4 handled here (see docs/plans/gbuffer_normal_pass.md)
    int    sceneHasGlass; // P6 — 0 when no MAT_FLAG_GLASS geometry is in the TLAS; skips the glass probe
    float  minWeight;     // r_rtReflectionMinWeight — pre-trace Fresnel cull (R1)
    float  grazingGain;   // r_rtSpecGrazingGain — low-F0 grazing ceiling as a multiple of F0 (R2)
    int    rectOriginX;   // R6 — launch-grid origin, added to gl_LaunchIDEXT below
    int    rectOriginY;
    int    reflMode;      // r_rtReflectionMode — 1 glass-only, 2 legacy full-screen
} params;

#include "reflect_payload.glsl"
layout(location = 0) rayPayloadEXT ReflPayload reflPayload;

#include "rt_indirect.glsl"
#include "glass_probe_payload.glsl"
layout(location = 1) rayPayloadEXT GlassProbePayload glassProbe;


void main()
{
    // R6: the launch grid covers only the glass screen rect in glass-only mode, so
    // pixel coordinates are grid position + rect origin. Full-screen modes pass (0,0).
    ivec2 coord = ivec2(gl_LaunchIDEXT.xy) + ivec2(params.rectOriginX, params.rectOriginY);
    ivec2 size  = params.screenSize;

    // G-buffer normal/F0 (Stage 3.5) + debug modes (Step 9). Checked first, before
    // any ray tracing, so debug output stays cheap and reflects exactly what the
    // depth prepass wrote — see docs/plans/gbuffer_normal_pass.md.
    // Fetch coord is clamped because the bound image may be the 1x1 null fallback
    // (gbufferSupported false) — texelFetch out of bounds is undefined without
    // robustImageAccess.
    ivec2 gbufSize = textureSize(gbufNormalSampler, 0);
    vec4  gbuf = texelFetch(gbufNormalSampler, min(coord, gbufSize - 1), 0);
    float f0   = gbuf.a;

    if (params.debugMode == 2)
    {
        // Raw world normal as RGB — a grate floor must look bumpy/detailed, not
        // flat single-colour; silhouette edges must match geometry.
        imageStore(reflImage, coord, vec4(gbuf.rgb, 1.0));
        return;
    }
    if (params.debugMode == 3)
    {
        // F0 (alpha) greyscale — most of the scene near-black, metal/wet trim
        // grey, nothing solid white.
        imageStore(reflImage, coord, vec4(vec3(f0), 1.0));
        return;
    }
    if (params.debugMode == 4)
    {
        // Prepass-coverage check: pixels the prepass never wrote (rgb still at the
        // 0.5/0.5/0.5 clear sentinel — no unit normal encodes there) tinted magenta;
        // should be only sky/translucents once the prepass covers the scene. Can't
        // test f0 here: black/absent specular maps legitimately write f0 == 0.
        bool noData = all(lessThanEqual(abs(gbuf.rgb - vec3(0.5)), vec3(1.0 / 255.0)));
        imageStore(reflImage, coord, noData ? vec4(1.0, 0.0, 1.0, 1.0) : vec4(0.0));
        return;
    }

    float depth = texelFetch(depthSampler, coord, 0).r;

    // Sky / no geometry — no surface to reflect from
    if (depth >= 1.0)
    {
        imageStore(reflImage, coord, vec4(0.0));
        return;
    }

    vec3 worldPos = rt_ReconstructWorldPos(coord, size, params.invViewProj);

    // Camera position
    vec4 camClip  = vec4(0.0, 0.0, -1.0, 1.0);
    vec4 camWorld = params.invViewProj * camClip;
    vec3 camPos   = camWorld.xyz / camWorld.w;
    vec3 viewDir  = normalize(worldPos - camPos);   // points away from camera

    // --- Glass probe ---
    // The depth buffer records the opaque surface *behind* any glass (glass
    // never writes depth).  Fire a probe ray from the camera with
    // CullOpaque so only non-opaque (glass/translucent) geometry is tested.
    // If glass is found, use the glass surface as the reflection origin so
    // the mirror image shows the room the player is standing in, not the
    // room beyond the glass.
    // P6: skipped wholesale when the TLAS holds no glass geometry — the probe
    // can't hit anything, and this saves a full-screen ray dispatch in most rooms.
    // R6: in glass-only mode the launch rect is derived from SURFTYPE_GLASS surfaces
    // actually in the view, which is a stricter test than sceneHasGlass (that flag is
    // set for any MC_TRANSLUCENT geometry) — so don't let it veto the probe here.
    float distToSurface = length(worldPos - camPos);
    glassProbe.hitT = 0.0;
    if (params.sceneHasGlass != 0 || params.reflMode == 1)
    {
        traceRayEXT(
            topLevelAS,
            gl_RayFlagsCullOpaqueEXT,
            0xFEu,          // normal mode excludes player bit only
            1,              // SBT hit offset 1: second entry in hit region = glass_probe.rchit
            0,              // SBT stride 0: ALL geometries use the same hit group (no per-geom offset)
            1,              // miss index 1: second entry in miss region = glass_probe.rmiss
            camPos, 0.01,
            viewDir, distToSurface,
            1               // payload location 1
        );
    }

    // R6 glass-only: opaque geometry never reflects, so a pixel with no glass in
    // front of it is done here — no G-buffer F0, no Fresnel, no bounce ray.
    if (params.reflMode == 1 && glassProbe.hitT <= 0.01)
    {
        imageStore(reflImage, coord, vec4(0.0));
        return;
    }

    // EARLY-OUT: opaque, non-reflective pixel with no glass in front of it — skip
    // the reflect ray + shadow rays entirely. This is the perf win the G-buffer
    // exists for. Placed after the glass probe: glass reflections don't depend on
    // surface F0, so a glass hit must still fall through to the trace loop below.
    if (glassProbe.hitT <= 0.01 && f0 < 1.0 / 255.0)
    {
        imageStore(reflImage, coord, vec4(0.0));
        return;
    }

    vec3 reflOrigin, reflNormal;
    bool isGlass = glassProbe.hitT > 0.01;
    if (isGlass)
    {
        // Glass surface found between camera and depth surface.
        reflOrigin = glassProbe.hitPos;
        reflNormal = glassProbe.hitNormal;
    }
    else if (gbuf.a > 0.0)
    {
        // Bump-mapped shading normal from the depth prepass — fixes flat-polygon
        // surfaces (e.g. grate floors) that rt_ReconstructNormal's depth-gradient
        // fallback reflects incorrectly (see docs/plans/gbuffer_normal_pass.md).
        reflNormal = normalize(gbuf.rgb * 2.0 - 1.0);
        reflOrigin = worldPos;
    }
    else
    {
        // No glass, no G-buffer data (gbufferSupported false at runtime, or sky/
        // translucent geometry the prepass doesn't write) — reconstruct from depth
        // gradients as before this feature existed.
        reflNormal = rt_ReconstructNormal(coord, size, params.invViewProj, worldPos, -viewDir);
        reflOrigin = worldPos;
    }

    // Mirror-reflect view direction around surface normal
    vec3 reflDir  = reflect(viewDir, reflNormal);

    // R1/R2: the opaque Fresnel weight depends only on f0, the normal and the view
    // direction — all known here — so compute it before tracing and cull on the
    // result. Glass is exempt: its weight comes from the interface, not surface F0.
    float fresnel = 0.0;
    if (!isGlass)
    {
        float NdotV = clamp(dot(reflNormal, -viewDir), 0.0, 1.0);
        // R2: ceiling scales with F0 instead of a flat grazingMax for everything, so
        // a near-matte surface stays near-matte at glancing angles. grazingMax remains
        // the hard cap; max() keeps the lobe monotonic when f0 exceeds it.
        float grazingLow = max(f0, min(f0 * params.grazingGain, params.grazingMax));
        float grazing    = mix(grazingLow, 1.0, smoothstep(0.3, 0.7, f0));
        fresnel = f0 + (grazing - f0) * pow(1.0 - NdotV, 5.0);

        if (fresnel * params.reflBlend < params.minWeight)
        {
            imageStore(reflImage, coord, vec4(0.0));
            return;
        }
    }

    // Bias origin off surface to avoid self-intersection
    vec3 origin = reflOrigin + reflNormal * 0.5;

    // Bounce loop: up to 2 iterations covers double-pane glass.
    // Each glass hit contributes 5 % and passes 95 % to the next segment.
    vec3  accum  = vec3(0.0);
    float weight = 1.0;
    vec3  dir    = reflDir;

    for (int i = 0; i < 2 && weight > 0.01; i++)
    {
        reflPayload.colour        = vec3(0.0);
        reflPayload.transmittance = 0.0;

        traceRayEXT(
            topLevelAS,
            gl_RayFlagsNoneEXT,
            0xFFu,
            0,              // SBT hit offset 0: first entry in hit region = reflect_ray.rchit
            0,              // SBT stride 0: ALL geometries use the same hit group
            0,              // miss index 0: first entry in miss region = reflect_ray.rmiss
            origin,
            0.01,           // tMin
            dir,
            params.maxDist,
            0               // payload location
        );

        accum  += weight * reflPayload.colour;
        weight *= reflPayload.transmittance;
        if (reflPayload.transmittance > 0.0)
        {
            origin = reflPayload.nextOrigin;
            dir    = reflPayload.nextDir;
        }
    }

    if (isGlass)
    {
        // Glass: encode Schlick Fresnel for the camera-facing glass interface.
        // Alpha is stored NEGATED as a sentinel: the depth buffer at a
        // glass pixel belongs to the opaque surface *behind* the glass (glass
        // never writes depth), so refl_composite.frag's fullscreen pass must not
        // also apply this radiance.
        const float GLASS_F0 = 0.15;
        float cosTheta = clamp(abs(dot(normalize(reflNormal), normalize(reflDir))), 0.0, 1.0);
        float oneMinusCos = 1.0 - cosTheta;
        float glassWeight =
            GLASS_F0 + (1.0 - GLASS_F0) * oneMinusCos * oneMinusCos * oneMinusCos * oneMinusCos * oneMinusCos;
        imageStore(reflImage, coord, vec4(accum * params.reflBlend, -glassWeight));
        return;
    }

    // Opaque surface: `fresnel` was computed above the trace loop (R1) — reusing it
    // here is what makes the pre-trace cull exact rather than an approximation.
    // refl_composite.frag adds this straight through (no further Fresnel math there);
    // alpha carries F0 for potential future consumers (non-negative — "not glass").
    imageStore(reflImage, coord, vec4(accum * params.reflBlend * fresnel, f0));
}
