/*
===========================================================================

dhewm3-rt Vulkan — Reflection ray generation shader.

For every non-sky pixel:
  0. Sample the G-buffer normal/F0 (Stage 3.5, see docs/plans/gbuffer_normal_pass.md)
     written by the depth prepass. r_rtReflectionDebugMode 2/3/4/12 short-circuit here
     to visualize it directly, before any ray tracing (12 is Stage 2's roughness —
     20261013_reflection_roughness.md). Mode 6 (B0, see
     docs/plans/20260918_reflection_brightness.md) short-circuits after the bounce
     loop but before any Fresnel weighting.
  1. Reconstruct world-space position and the mirror-reflected view direction.
     Early-out on pixels with no glass in front and F0 ~ 0, OR (r_rtReflectionMode 3,
     Stage 4) roughness at/above r_rtReflRoughnessMax — skips the reflect ray + shadow
     rays either way, the perf win this buffer exists for, and in mode 3's case also
     what keeps the lobe from double-counting GI at high roughness (rt_engine_rules.md
     pillar 2). Mode 13 visualizes the boundary instead of tracing.
  2. Compute the Schlick Fresnel term ONCE per pixel (not per-light — the bug this
     effort exists to fix, Step 8) from the bump-mapped shading normal, evaluated
     against the macro normal (not the GGX half-vector below) so R1's pre-trace cull
     stays exact and doesn't need the lobe sampled first. R1 does this BEFORE the
     trace and returns early under r_rtReflectionMinWeight.
  2b. Opaque pixels past that cull replace the mirror direction with a GGX VNDF
     sample (Stage 3, 20261013_reflection_roughness.md, rt_ggx.glsl) using Stage 2's
     per-pixel roughness; roughness 0 reduces exactly to the same mirror direction.
     Glass never takes this branch — see the isGlass check below.
  3. Trace the reflection ray. Glass along it is skipped in rahit (pure
     transmission), so rchit/rmiss return the opaque hit or sky. The bounce loop
     only continues if a hit shader sets transmittance > 0 (none currently do).
     Projectile glow discs (rt_emitter.glsl) nearer than the first hit are added
     here; projectiles are not in the TLAS.
  4. Write the Fresnel-weighted radiance to the reflection RGBA16F buffer.
     Glass pixels are the exception: they store raw
     radiance + glassWeight in NEGATED alpha, a sentinel telling
     refl_composite.frag to skip them — they're composited separately by
     glass_refl_overlay.frag, since the depth/G-buffer at a glass pixel belongs
     to the unrelated opaque surface behind the glass.

refl_composite.frag additively blends non-glass pixels onto the framebuffer
once per view (replacing the disabled per-light reflection block in
interaction.frag). glass_refl_overlay.frag composites glass pixels separately,
once per MC_TRANSLUCENT surface.

params.population (Stage 4b) says which surfaces this dispatch owns, so glass and
opaque can be traced at different rates into separate images:
  REFL_POP_GLASS  — launched over the glass rect; writes glass pixels, zeroes the rest.
  REFL_POP_OPAQUE — full-screen; zeroes pixels glass owns, so the two never overlap.
                    Its glass probe fires only inside params.glassRect, which is the
                    saving: a glass-free view spends no probes at all.
  REFL_POP_BOTH   — the pre-split single dispatch, still used by r_rtReflectionMode 2
                    and every debug mode, which need one image to land in.

This file is a new addition with dhewm3-rt.  It was created with the aid of GenAI, and
may reference the existing Dhewm3 OpenGL and vkDoom3 Vulkan updates of the Doom 3 GPL Source Code.

It is distributed under the same modified GNU General Public License Version 3
of the original Doom 3 GPL Source Code release.

===========================================================================
*/

#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_EXT_nonuniform_qualifier : enable

layout(set = 0, binding = 0) uniform accelerationStructureEXT topLevelAS;
layout(set = 0, binding = 1, rgba16f) uniform image2D reflImage;
layout(set = 0, binding = 2) uniform sampler2D depthSampler;
// G-buffer normal/F0 (Stage 3.5); layout in rt_gbuf_normal_fmt.glsl.
// a == 0 means "no usable normal" (gbufferSupported false, sky/translucent
// geometry, or a surface whose specular map remaps to F0 == 0) — fall back to
// rt_ReconstructNormal; !GBuf_NormalValid means the prepass never
// wrote the pixel at all (debug mode 4 tests this). Sampled with texelFetch, so the bound
// sampler's filter/wrap state is irrelevant; always valid (real image when
// vk.gbufferSupported, a 1x1 null image with a=0 otherwise — see VK_RT_DispatchReflections).
layout(set = 0, binding = 5) uniform sampler2D gbufNormalSampler;
// gbufAlbedo's alpha (Stage 2, 20261013_reflection_roughness.md): packed class +
// roughness, see gbuf_albedo_class.glsl. Debug mode 12 only for now; Stage 3's GGX
// lobe is the real consumer. Same fallback convention as gbufNormalSampler — the
// shared 1x1 null image when !gbufferSupported (VK_RT_GetNullGbufNormalView).
layout(set = 0, binding = 9) uniform sampler2D gbufAlbedoSampler;

layout(set = 0, binding = 3) uniform ReflParams {
    mat4   invViewProj;
    float  maxDist;
    uint   frameIndex;
    ivec2  screenSize;
    float  reflBlend;     // r_rtReflectionBlend — scale baked in at imageStore time
    float  roughnessScale; // r_rtReflRoughnessScale (Stage 3) — multiplies Stage 2's packed
                           // roughness before squaring to GGX alpha; retunes the lobe width
    int    debugMode;     // r_rtReflectionDebugMode — 2/3/4/6/12/13 handled here
    int    sceneHasGlass; // P6 — 0 when no MAT_FLAG_GLASS geometry is in the TLAS; skips the glass probe
    float  minWeight;     // r_rtReflectionMinWeight — pre-trace Fresnel cull (R1)
    int    rectOriginX;   // R6 — launch-grid origin, added to gl_LaunchIDEXT below
    int    rectOriginY;
    int    reflMode;      // r_rtReflectionMode — 1 glass-only, 2 legacy full-screen, 3 glass+opaque (Stage 4)
    int    emitterCount;  // projectile glow discs in emitterBuf (0 = r_rtReflGlow off)
    float  glowGain;      // r_rtReflGlowGain (0 when r_rtReflGlow is off)
    int    glowTriCount;  // additive translucent triangles in emitterBuf.tris
    float  roughLumExp;   // r_rtReflRoughLumExp — ceiling scales by (1 - roughness)^this

    // Froxel scatter grid (20261013_reflection_volumetrics.md). viewProj is the
    // grid's own, GL convention — the matrix its invViewProj inverts, jitter and all.
    mat4   viewProj;
    vec4   froxelCamPos;
    vec4   froxelCamFwd;
    float  froxelDNear;
    float  froxelLogRange;
    float  froxelInvLogRange;
    int    froxelNz;
    int    volSteps;      // 0 = no usable grid this frame; take no samples
    float  volGain;
    float  volIsoMix;     // r_rtVolIsotropicMix — Stage 5, for rt_PhaseFromMeanDir
    int    glassNormalMode; // r_rtGlassNormalMode — 0 interpolated, 1 face, 2 crease-aware
    float  glassCreaseRatio; // r_rtGlassCreaseRatio — mode 2 flattens when devRatio < this
    float  guiReflGain;   // r_rtGuiReflGain — scales live GUI screen hits
    float  roughnessMax;  // r_rtReflRoughnessMax (Stage 4) — reflMode 3 only; above this an
                           // opaque pixel skips the reflection ray and takes GI alone
    float  maxLuminance;  // r_rtReflMaxLuminance (2026-10-16 addendum) — hard luminance
                           // ceiling on the final opaque radiance below. 0 = unbounded.
    int    shadowPicks;   // r_rtReflShadowPicks — opaque hits: 0 deterministic loop, 1-2 stochastic

    int    population;    // Stage 4b — REFL_POP_*, which surfaces this dispatch owns
    int    glassRectX;    // union of the SURFTYPE_GLASS scissors; OPAQUE probes only inside it
    int    glassRectY;
    int    glassRectW;    // 0 = no glass in view
    int    glassRectH;
} params;

// Must match the REFL_POP_* defines in vk_reflections.cpp.
#define REFL_POP_BOTH   0
#define REFL_POP_GLASS  1
#define REFL_POP_OPAQUE 2

// Grid math only — no bindings of its own, so it can live alongside this set.
#include "vol_froxel_sample.glsl"
#include "rt_phase.glsl"
#include "gbuf_albedo_class.glsl"
#include "rt_gbuf_normal_fmt.glsl"
#include "refl_alpha.glsl"
#include "rt_ggx.glsl"

// binding 7: the scatter grid itself. rgb = in-scatter per unit length and, since
// Stage 5, WITHOUT the phase function; a = extinction. No camera-path integration
// baked in either. Always valid: the live grid, or a 1x1x1 black stand-in with
// volSteps 0 to match.
layout(set = 0, binding = 7) uniform sampler3D froxelScatterSampler;

// binding 8 (Stage 5): the companion mean-direction grid. xyz = cell toward the
// light, |xyz| = effective g. This is what lets the reflected segment evaluate its
// OWN phase angle instead of inheriting the camera's — see rt_phase.glsl.
layout(set = 0, binding = 8) uniform sampler3D froxelDirSampler;

// This frame's grid, in the form vol_froxel_sample.glsl's helpers want.
VolFroxelSlices refl_FroxelSlices()
{
    VolFroxelSlices s;
    s.dNear       = params.froxelDNear;
    s.logRange    = params.froxelLogRange;
    s.invLogRange = params.froxelInvLogRange;
    s.nz          = params.froxelNz;
    return s;
}

// Projectile glow emitters (vk_rt_emitters.cpp), filled per frame slot.
#include "rt_emitter.glsl"
layout(set = 0, binding = 6, std430) readonly buffer EmitterBuf {
    RtEmitter emitters[RT_MAX_EMITTERS];
    RtGlowTri tris[RT_MAX_GLOW_TRIS];
} emitterBuf;

// Only the bindless array from the shared material set. rt_material.glsl is not
// included: its rt_InterpolateNormal uses a hit-shader-only built-in.
layout(set = 1, binding = 3) uniform sampler2D matTextures[4096];

#include "reflect_payload.glsl"
layout(location = 0) rayPayloadEXT ReflPayload reflPayload;

// Copy of rt_material.glsl's flag, for the live-GUI gain on payload.hitFlags.
#define MAT_FLAG_GUI_LIVE 0x100u

#include "rt_indirect.glsl"
#include "glass_probe_payload.glsl"
layout(location = 1) rayPayloadEXT GlassProbePayload glassProbe;

// 2026-10-16 addendum: a flat, absolute brightness ceiling on the final opaque radiance
// (r_rtReflMaxLuminance), distinct from refl_atrous.comp's firefly clamp — that one is
// LOCAL (only pulls down a texel that disagrees with its own neighbours), this one is a
// direct "how bright can any reflection pixel get" knob for tuning overall brightness
// down regardless of whether a pixel is a sampling outlier. 0 = unbounded.
vec3 ReflClampLuminance(vec3 c, float maxLum)
{
    if (maxLum <= 0.0)
        return c;
    float lum = dot(c, vec3(0.2126, 0.7152, 0.0722));
    return (lum > maxLum) ? c * (maxLum / max(lum, 1e-5)) : c;
}

// ---------------------------------------------------------------------------
// In-scatter along the reflected segment (20261013_reflection_volumetrics.md).
//
// froxelScatter stores per-cell in-scattered radiance per unit length and the
// extinction coefficient, with no camera-path integration baked in, so the same
// volume the primary view resolves can be marched by any ray. That is what puts
// the flashlight beam into glass.
//
// Steps outside the grid contribute nothing AND do not attenuate: the medium
// beyond the froxel frustum is simply unknown here, and guessing at it would
// darken reflections of rooms the grid never covered.
//
// The jitter is spatial only, never per frame. Nothing downstream denoises the
// reflection buffer, so a per-frame offset would read as a shimmering beam
// instead of a static dither.
// ---------------------------------------------------------------------------
vec3 ReflVolumetrics(vec3 o, vec3 d, float hitT, ivec2 coord)
{
    int n = params.volSteps;
    if (n <= 0 || hitT <= 0.0)
        return vec3(0.0);

    VolFroxelSlices slices = refl_FroxelSlices();

    float segLen = hitT / float(n);
    float jitter = randFloat(wang_hash(uint(coord.x) * 73856093u ^ wang_hash(uint(coord.y) * 19349663u)));

    vec3  scattered    = vec3(0.0);
    float transmitting = 1.0;

    for (int i = 0; i < n; i++)
    {
        vec3 p = o + d * ((float(i) + jitter) * segLen);

        vec3 tc;
        if (!vfs_WorldToTexCoord(slices, params.viewProj, params.froxelCamPos.xyz, params.froxelCamFwd.xyz, p, tc))
            continue;

        vec4 cell = texture(froxelScatterSampler, tc);

        // Stage 5: the phase for THIS ray. A mirror puts the reflected segment at
        // the opposite end of the flashlight's lobe from the camera — measured 21x
        // at the g=0.7/isoMix=0.45 defaults — which is why the pre-Stage-5 code
        // needed r_rtReflVolGain 2.0 as a flat stand-in and still read too bright
        // at high angles and far too dim head-on.
        vec3 meanDir = texture(froxelDirSampler, tc).xyz;
        float phase  = rt_PhaseFromMeanDir(d, meanDir, params.volIsoMix);

        scattered += transmitting * cell.rgb * phase * segLen;
        transmitting *= exp(-cell.a * segLen);
        if (transmitting < 0.01)
            break;
    }

    return scattered * params.volGain;
}

// Projectile glows along (o, d) in front of the reflected surface at hitT.
vec3 ReflEmitterGlow(vec3 o, vec3 d, float hitT)
{
    vec3 sum = vec3(0.0);
    int n = min(params.emitterCount, RT_MAX_EMITTERS);
    for (int i = 0; i < n; i++)
    {
        RtEmitter e = emitterBuf.emitters[i];
        float t, rho2;
        vec2  uv;
        if (!rt_EmitterDisc(e, o, d, t, uv, rho2))
            continue;
        if (t >= hitT)
            continue;

        vec3 tex;
        uint slot = rt_EmitterTexSlot(e.texIndex);
        if (slot == 0u)
        {
            float f = 1.0 - rho2;
            tex = vec3(f * f);
        }
        else
        {
            // Soft rim: the disc clips the texture's corners, which may not be black.
            vec4 texel = textureLod(matTextures[nonuniformEXT(slot)], uv, 0.0);
            tex = rt_EmitterTexColor(texel, e.texIndex) * (1.0 - smoothstep(0.8, 1.0, sqrt(rho2)));
        }
        sum += e.rgb * tex;
    }

    // Additive translucent triangles (scanner beams); same occlusion rule as the discs.
    int nt = min(params.glowTriCount, RT_MAX_GLOW_TRIS);
    for (int i = 0; i < nt; i++)
    {
        RtGlowTri g = emitterBuf.tris[i];
        float t;
        vec2  uv;
        if (!rt_GlowTriHit(g, o, d, t, uv))
            continue;
        if (t >= hitT)
            continue;
        uint slot = rt_EmitterTexSlot(g.texIndex);
        vec3 tex = vec3(1.0);
        if (slot != 0u)
            tex = rt_EmitterTexColor(textureLod(matTextures[nonuniformEXT(slot)], uv, 0.0), g.texIndex);
        sum += g.rgb * tex;
    }
    return sum * params.glowGain;
}

// Roughness-aware Schlick (split-sum IBL form): the grazing limit is
// max(1 - roughness, f0) instead of 1, so rough painted metal and grates don't
// turn into bright mirrors at grazing angles.  Called twice per opaque pixel
// (Stage 2b) — once on the coarse F0 to admit the ray, once on the fine one for
// the weight that leaves in the alpha channel.
float ReflFresnel(float f0, float perceptualRoughness, float NdotV)
{
    float fGrazing = max(1.0 - perceptualRoughness, f0);
    return f0 + (fGrazing - f0) * pow(1.0 - NdotV, 5.0);
}

void main()
{
    // R6: glass-only launches only over the glass rect; full-screen modes pass (0,0).
    ivec2 coord = ivec2(gl_LaunchIDEXT.xy) + ivec2(params.rectOriginX, params.rectOriginY);
    ivec2 size  = params.screenSize;

    // G-buffer normal/F0 (Stage 3.5) + debug modes (Step 9). Checked first, before
    // any ray tracing, so debug output stays cheap and reflects exactly what the
    // depth prepass wrote — see docs/plans/gbuffer_normal_pass.md.
    // Fetch coord is clamped because the bound image may be the 1x1 null fallback
    // (gbufferSupported false) — texelFetch out of bounds is undefined without
    // robustImageAccess.
    ivec2 gbufSize = textureSize(gbufNormalSampler, 0);
    vec4  gbuf = texelFetch(gbufNormalSampler, min(coord, gbufSize - 1), 0);
    // Two F0s (Stage 2b): the fine, per-pixel one weights this pixel's reflection;
    // the coarse, fixed-mip one decides whether a ray is traced at all. Separating
    // them is what stops a scuffed texel from becoming a hole in the filters' input.
    float f0Fine   = gbuf.a;
    float f0Coarse = GBuf_CoarseF0(gbuf);

    // Stage 2 packed roughness. Fetched this early (not just for mode 12 below) so
    // Stage 4's roughness ceiling can gate the opaque early-out before any ray tracing,
    // same reasoning as f0 being fetched up here instead of inside the opaque branch.
    ivec2 albedoSize = textureSize(gbufAlbedoSampler, 0);
    float roughness  = GBuf_UnpackRoughness(texelFetch(gbufAlbedoSampler, min(coord, albedoSize - 1), 0).a);

    if (params.debugMode == 2)
    {
        // Decoded world normal as RGB — a grate floor must look bumpy/detailed, not
        // flat single-colour; silhouette edges must match geometry.
        vec3 nDbg = GBuf_NormalValid(gbuf) ? (GBuf_DecodeNormal(gbuf.rg) * 0.5 + 0.5) : vec3(0.5);
        imageStore(reflImage, coord, vec4(nDbg, 1.0));
        return;
    }
    if (params.debugMode == 3)
    {
        // Fine F0 (alpha) greyscale — most of the scene near-black, metal/wet trim
        // grey, nothing solid white.
        imageStore(reflImage, coord, vec4(vec3(f0Fine), 1.0));
        return;
    }
    if (params.debugMode == 4)
    {
        // Prepass-coverage check: pixels the prepass never wrote (B still at the 1.0
        // clear sentinel) tinted magenta; should be only sky/translucents once the
        // prepass covers the scene. Can't test f0 here: black/absent specular maps
        // legitimately write f0 == 0.
        imageStore(reflImage, coord, GBuf_NormalValid(gbuf) ? vec4(0.0) : vec4(1.0, 0.0, 1.0, 1.0));
        return;
    }
    if (params.debugMode == 12)
    {
        // Stage 2 roughness as greyscale — rough concrete bright, polished trim and
        // glass dark, gradient should track visible surface detail.
        imageStore(reflImage, coord, vec4(vec3(roughness), 1.0));
        return;
    }

    float depth = texelFetch(depthSampler, coord, 0).r;

    // Sky / no geometry — no surface to reflect from
    if (depth >= 1.0)
    {
        imageStore(reflImage, coord, vec4(0.0));
        return;
    }

    vec3 worldPos = rt_ReconstructWorldPos(coord, size, params.invViewProj);

    // Camera position
    vec4 camClip  = vec4(0.0, 0.0, -1.0, 1.0);
    vec4 camWorld = params.invViewProj * camClip;
    vec3 camPos   = camWorld.xyz / camWorld.w;
    vec3 viewDir  = normalize(worldPos - camPos);   // points away from camera

    // --- Glass probe ---
    // The depth buffer records the opaque surface *behind* any glass (glass
    // never writes depth).  Fire a probe ray from the camera with
    // CullOpaque so only non-opaque (glass/translucent) geometry is tested.
    // If glass is found, use the glass surface as the reflection origin so
    // the mirror image shows the room the player is standing in, not the
    // room beyond the glass.
    // P6: skipped wholesale when the TLAS holds no glass geometry — the probe
    // can't hit anything, and this saves a full-screen ray dispatch in most rooms.
    // R6: the glass-only launch rect comes from real SURFTYPE_GLASS surfaces in view,
    // a stricter test than sceneHasGlass (any MC_TRANSLUCENT) — don't let it veto.
    // Stage 4b: REFL_POP_OPAQUE fires the probe only to suppress itself where glass
    // owns the pixel, and the glass rect bounds where that can happen — outside it the
    // probe could only miss. This is the saving the split buys: a glass-free view goes
    // from one probe per screen pixel to none.
    // POP_GLASS overrides sceneHasGlass for the same reason reflMode 1 does: its launch
    // rect comes from real SURFTYPE_GLASS surfaces in view, a stricter test than
    // sceneHasGlass (any MC_TRANSLUCENT), so the looser flag must not veto it.
    bool probeNeeded = (params.sceneHasGlass != 0 || params.reflMode == 1 || params.population == REFL_POP_GLASS);
    if (params.population == REFL_POP_OPAQUE)
    {
        bool inGlassRect = params.glassRectW > 0 && params.glassRectH > 0 &&
                           coord.x >= params.glassRectX && coord.x < params.glassRectX + params.glassRectW &&
                           coord.y >= params.glassRectY && coord.y < params.glassRectY + params.glassRectH;
        probeNeeded = probeNeeded && inGlassRect;
    }

    float distToSurface = length(worldPos - camPos);
    glassProbe.hitT = 0.0;
    if (probeNeeded)
    {
        traceRayEXT(
            topLevelAS,
            gl_RayFlagsCullOpaqueEXT,
            0xFDu,          // normal mode excludes player bit only
            1,              // SBT hit offset 1: second entry in hit region = glass_probe.rchit
            0,              // SBT stride 0: ALL geometries use the same hit group (no per-geom offset)
            1,              // miss index 1: second entry in miss region = glass_probe.rmiss
            camPos, 0.01,
            viewDir, distToSurface,
            1               // payload location 1
        );
    }

    // R6 glass-only / Stage 4b glass chain: no glass in front means done — no F0,
    // Fresnel, or bounce ray. This dispatch owns glass pixels and nothing else.
    if ((params.reflMode == 1 || params.population == REFL_POP_GLASS) && glassProbe.hitT <= 0.01)
    {
        imageStore(reflImage, coord, vec4(0.0));
        return;
    }

    // Stage 4b opaque chain: glass owns this pixel and stores its radiance in the glass
    // chain's image. Writing here too would composite the behind-glass surface's
    // reflection on top of the pane's, which the single-buffer path never did.
    if (params.population == REFL_POP_OPAQUE && glassProbe.hitT > 0.01)
    {
        imageStore(reflImage, coord, vec4(0.0));
        return;
    }

    // Stage 4 roughness ceiling (r_rtReflRoughnessMax, mode 3 only): above it, the GGX
    // lobe is wide enough that it's approximating the same hemisphere probe GI already
    // integrates, so tracing both would sum two independent noisy estimates of the same
    // quantity instead of two distinct ones. >= so a ceiling of exactly 0 disqualifies
    // every opaque pixel regardless of r_rtReflRoughnessFloor, making mode 3 reproduce
    // mode 1 exactly rather than merely approximating it.
    bool tooRoughForMode3 = (params.reflMode == 3) && (roughness >= params.roughnessMax);

    if (params.debugMode == 13)
    {
        // Stage 4 GI/reflection handoff audit: forces reflMode 3 above (see the UBO
        // fill in vk_reflections.cpp) regardless of the real cvar, so sweeping
        // r_rtReflRoughnessMax moves the blue/green boundary live.
        vec3 tint;
        if (glassProbe.hitT > 0.01)
            tint = vec3(1.0, 1.0, 1.0);                  // white: glass, always reflects
        else if (f0Coarse < 1.0 / 255.0 || tooRoughForMode3)
            tint = vec3(0.0, 1.0, 0.0);                  // green: GI only
        else
            tint = vec3(0.0, 0.3, 1.0);                  // blue: reflection + GI (both)
        imageStore(reflImage, coord, vec4(tint, 1.0));
        return;
    }

    // EARLY-OUT: opaque, non-reflective (or, in mode 3, too-rough) pixel with no glass
    // in front of it — skip the reflect ray + shadow rays entirely. This is the perf
    // win the G-buffer exists for. Placed after the glass probe: glass reflections
    // don't depend on surface F0 or roughness, so a glass hit must still fall through
    // to the trace loop below regardless of either.
    if (glassProbe.hitT <= 0.01 && (f0Coarse < 1.0 / 255.0 || tooRoughForMode3))
    {
        imageStore(reflImage, coord, vec4(0.0));
        return;
    }

    vec3 reflOrigin, reflNormal;
    bool isGlass = glassProbe.hitT > 0.01;
    if (isGlass)
    {
        // Glass surface found between camera and depth surface.
        reflOrigin = glassProbe.hitPos;
        reflNormal = glassProbe.hitNormal;
        if (params.glassNormalMode == 1 ||
            (params.glassNormalMode == 2 && glassProbe.devRatio < params.glassCreaseRatio))
            reflNormal = glassProbe.faceNormal;
    }
    else if (gbuf.a > 0.0)
    {
        // Bump-mapped shading normal from the depth prepass — fixes flat-polygon
        // surfaces (e.g. grate floors) that rt_ReconstructNormal's depth-gradient
        // fallback reflects incorrectly (see docs/plans/gbuffer_normal_pass.md).
        reflNormal = GBuf_DecodeNormal(gbuf.rg);
        reflOrigin = worldPos;
    }
    else
    {
        // No glass, no G-buffer data (gbufferSupported false at runtime, or sky/
        // translucent geometry the prepass doesn't write) — reconstruct from depth
        // gradients as before this feature existed.
        reflNormal = rt_ReconstructNormal(coord, size, params.invViewProj, worldPos, -viewDir);
        reflOrigin = worldPos;
    }

    // Mirror-reflect view direction around surface normal. Exact for glass (Stage 3,
    // 20261013_reflection_roughness.md: a pane stays a delta BRDF) and the degenerate
    // rt_ReconstructNormal fallback; replaced below by a GGX sample for real opaque
    // geometry — rt_SampleGGXReflection collapses to this same formula at alpha 0, so
    // that replacement never changes glass's own path, only the branch glass skips.
    vec3 reflDir  = reflect(viewDir, reflNormal);

    // R1: the weight depends only on F0/normal/viewDir — all known pre-trace — so cull
    // on it here. Glass is exempt; its weight comes from the interface, not surface F0.
    // Stage 2b: the cull reads the COARSE F0, the stored weight the fine one.
    float fresnel = 0.0;
    float lumCeiling = params.maxLuminance;
    uint  lightSeed  = 0u;
    int   lightPicks = 0;
    if (!isGlass)
    {
        float NdotV = clamp(dot(reflNormal, -viewDir), 0.0, 1.0);
        // `roughness` was fetched up top, alongside f0, for Stage 4's ceiling check.
        // r_rtReflRoughnessScale retunes Stage 2's packed roughness before the standard
        // perceptual-roughness-squared remap to GGX alpha.
        float perceptualRoughness = clamp(roughness * params.roughnessScale, 0.0, 1.0);

        // Rough lobes catch a small bright emitter (LED, lamp) on one ray in many, at full
        // brightness: speckle. Lowering the ceiling with roughness turns that into a dim
        // glow while dim reflected walls stay under it untouched.
        // Floored above 0: ReflClampLuminance reads a 0 ceiling as "unbounded".
        if (params.roughLumExp > 0.0 && params.maxLuminance > 0.0)
            lumCeiling = max(lumCeiling * pow(max(1.0 - perceptualRoughness, 0.0), params.roughLumExp), 1e-4);

        // Admission on the coarse F0: whether a ray exists is a panel-scale question.
        // Culling per-pixel left the filters with holes they cannot blur across.
        if (ReflFresnel(f0Coarse, perceptualRoughness, NdotV) * params.reflBlend < params.minWeight)
        {
            imageStore(reflImage, coord, vec4(0.0));
            return;
        }

        // The stored weight is per-pixel, demodulated out of rgb and reapplied by
        // refl_composite.frag — so scuff detail survives without patterning the
        // signal the denoisers see.
        fresnel = ReflFresnel(f0Fine, perceptualRoughness, NdotV);

        // GGX VNDF lobe (Stage 3): single sample per pixel, same world-anchored-seed
        // strategy as gi_ray.rgen so the noise is stable under a static camera and
        // decorrelates frame to frame — Stage 1's temporal denoiser resolves the
        // resulting variance over frames rather than this file sampling more of them.
        float alpha = perceptualRoughness * perceptualRoughness;

        uint  seed      = rt_WorldAnchoredSeed(worldPos, params.frameIndex);
        float phiOffset = rt_PixelPhiOffset(coord, params.frameIndex);
        float u1 = randFloat(seed);
        float u2 = fract(randFloat(seed + 1u) + phiOffset);
        reflDir  = rt_SampleGGXReflection(reflNormal, viewDir, alpha, u1, u2);

        // VNDF sampling only guarantees the sampled HALF-vector stays above the macro
        // normal — reflect()'ing the view direction around it can still come out below
        // the surface, especially at grazing angles with a wide lobe (high roughness).
        // Left unchecked, that ray heads back into the surface it just left, hits its
        // own backface or whatever is behind it (gl_RayFlagsNoneEXT does not cull
        // either), and reads as a dark speckle or a leak of the next room. Falling
        // back to the exact mirror direction is cheap and always valid.
        if (dot(reflDir, reflNormal) <= 0.0)
            reflDir = reflect(viewDir, reflNormal);

        // Stochastic light picks at the hit (refl-refactor Stage 1). The pixel hash keeps
        // neighbours in one world cell from all picking the same light, so à-trous can
        // average them; the constant decorrelates it from the GGX sample above.
        lightPicks = params.shadowPicks;
        lightSeed  = wang_hash(seed ^ wang_hash(uint(coord.x) * 73856093u ^ uint(coord.y) * 19349663u)
                               ^ 0x68bc21ebu);
    }

    // Bias origin off surface to avoid self-intersection
    vec3 origin = reflOrigin + reflNormal * 0.5;

    // Bounce loop: continues only while a hit shader returns transmittance > 0.
    // Glass is skipped in rahit, so this is currently a single trace.
    vec3  accum  = vec3(0.0);
    float weight = 1.0;
    vec3  dir    = reflDir;

    // First segment, for the emitter discs below.
    vec3  segOrigin = origin;
    float segHitT   = params.maxDist;

    for (int i = 0; i < 2 && weight > 0.01; i++)
    {
        reflPayload.colour        = vec3(0.0);
        reflPayload.transmittance = 0.0;
        reflPayload.hitT          = params.maxDist;
        reflPayload.hitFlags      = 0u;
        reflPayload.lightSeed     = lightSeed + uint(i) * 0x9e3779b9u;
        reflPayload.lightPicks    = lightPicks;

        traceRayEXT(
            topLevelAS,
            gl_RayFlagsNoneEXT,
            0xFFu,
            0,              // SBT hit offset 0: first entry in hit region = reflect_ray.rchit
            0,              // SBT stride 0: ALL geometries use the same hit group
            0,              // miss index 0: first entry in miss region = reflect_ray.rmiss
            origin,
            0.01,           // tMin
            dir,
            params.maxDist,
            0               // payload location
        );

        if (i == 0)
            segHitT = reflPayload.hitT;
        // A live screen's texture is the raw GUI, unblended with its housing; the gain
        // matches it to the on-screen raster GUI.
        if ((reflPayload.hitFlags & MAT_FLAG_GUI_LIVE) != 0u)
            reflPayload.colour *= params.guiReflGain;
        accum  += weight * reflPayload.colour;
        weight *= reflPayload.transmittance;
        if (reflPayload.transmittance > 0.0)
        {
            origin = reflPayload.nextOrigin;
            dir    = reflPayload.nextDir;
        }
    }

    // Projectile glows. Added before the Fresnel/glass weight so they read like the
    // rest of the reflected scene.
    if (params.emitterCount > 0 || params.glowTriCount > 0)
        accum += ReflEmitterGlow(segOrigin, reflDir, segHitT);

    // Light scattered by the air between the reflecting surface and what it sees —
    // emissive along the segment, so it joins accum on the same footing as the glows
    // rather than being tinted by the reflector.
    accum += ReflVolumetrics(segOrigin, reflDir, segHitT, coord);

    if (params.debugMode == 6)
    {
        // B0: raw traced radiance, before reflBlend and before any Fresnel/glass weight
        // — the measurement that separates "dark subject" from "weak interface".
        // Alpha is positive (not the glass sentinel) so refl_composite.frag displays it
        // with blending off, same as modes 2-4.
        imageStore(reflImage, coord, vec4(accum, 1.0));
        return;
    }

    if (isGlass)
    {
        // Glass: encode Schlick Fresnel for the camera-facing glass interface.
        // Alpha is stored NEGATED as a sentinel: the depth buffer at a
        // glass pixel belongs to the opaque surface *behind* the glass (glass
        // never writes depth), so refl_composite.frag's fullscreen pass must not
        // also apply this radiance.
        const float GLASS_F0 = 0.15;
        float cosTheta = clamp(abs(dot(normalize(reflNormal), normalize(reflDir))), 0.0, 1.0);
        float oneMinusCos = 1.0 - cosTheta;
        float glassWeight =
            GLASS_F0 + (1.0 - GLASS_F0) * oneMinusCos * oneMinusCos * oneMinusCos * oneMinusCos * oneMinusCos;
        imageStore(reflImage, coord, vec4(accum * params.reflBlend, -glassWeight));
        return;
    }

    // Opaque, demodulated (Stage 2b): rgb is incident light, alpha the Fresnel weight
    // refl_composite.frag multiplies back in. The ceiling therefore bounds incident
    // light rather than final radiance — one meaning for every pixel instead of
    // "ceiling / this pixel's F0", which is why r_rtReflMaxLuminance was rescaled.
    vec3 reflLight = ReflClampLuminance(accum * params.reflBlend, lumCeiling);
    imageStore(reflImage, coord, vec4(reflLight, ReflAlpha_Opaque(fresnel)));
}
