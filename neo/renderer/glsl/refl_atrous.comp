/*
===========================================================================

dhewm3-rt Vulkan — refl_atrous.comp — roughness-gated À-trous spatial filter
for RT reflections (Stage 1 addendum, docs/plans/20261013_reflection_roughness.md,
r_rtReflDenoise 2).

Same B3-spline À-trous pattern as gi_atrous.comp (N compute passes, step width
doubling each iteration, depth edge-stopping) run on top of the
temporal resolve's output, but gated per pixel by Stage 2's packed roughness:
the filtered and unfiltered colours are mixed by `roughness * roughnessGain`
(r_rtReflAtrousRoughnessGain), so a roughness-0 pixel (glass-sharp trim, GUI
screens) is still output byte-for-byte unchanged, but the gain lets everything
above that reach a full wash sooner than roughness alone would. This is what
keeps a polished-metal reflection crisp while washing out the grain on a rough
painted panel next to it.

Since Stage 2b the colour here is incident light with the per-pixel Fresnel
weight demodulated out (refl_alpha.glsl), so the blur crosses a scuffed texel
instead of stopping at it; refl_composite.frag reapplies the weight afterwards.

Glass pixels are passed through untouched and never contribute as a neighbour
sample: glass is hardcoded to roughness 0 structurally (Stage 3) and belongs to
a different surface than the opaque geometry this filter reasons about. Pixels
that never traced are excluded the same way — both as centres (nothing to
denoise) and as neighbour samples (blending one in would paint a reflection
onto a surface that was deliberately culled).

A local firefly clamp (r_rtReflAtrousFireflyClamp) runs before the blend: a single
GGX sample with no light importance sampling occasionally points straight at
something much brighter than its surroundings. Every tap is capped at the 3x3's
second-brightest luminance, which removes lone texels outright. No luminance
stop, so rough surfaces get a plain wash.

Edge stops (refl-refactor Stage 3): plane distance and normal. A tap's world
position is tested against the centre's geometric plane (normal from depth), as
a fraction of view distance — zero along any flat surface however grazing, so
floors still wash while a rail above them is cut. The G-buffer shading normal
stop splits creases; its power stays low because bump detail varies it too.
Debug mode 15 shows the combined step-1 weight.

Inputs (set 0):
  binding 0 (combined image sampler)          — reflection buffer for this pass (ping-pong)
  binding 1 (rgba16f, storage, GENERAL)        — output reflection buffer for this pass
  binding 2 (combined image sampler)           — scene depth buffer
  binding 3 (combined image sampler)           — gbufAlbedo (alpha = packed class + roughness)
  binding 4 (combined image sampler)           — gbufNormal (rt_gbuf_normal_fmt.glsl)

Push constants: 112 bytes, see PC below.

This file is a new addition with dhewm3-rt.  It was created with the aid of GenAI,
and may reference the existing Dhewm3 OpenGL and vkDoom3 Vulkan updates of the Doom 3 GPL Source
Code.

It is distributed under the same modified GNU General Public License Version 3 of the original Doom 3 GPL Source
Code release.

===========================================================================
*/

#version 460

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D reflSrc;
layout(set = 0, binding = 1, rgba16f) uniform image2D reflDst;
layout(set = 0, binding = 2) uniform sampler2D depthSampler;
layout(set = 0, binding = 3) uniform sampler2D gbufAlbedoSampler;
layout(set = 0, binding = 4) uniform sampler2D gbufNormalSampler;

#include "gbuf_albedo_class.glsl"
#include "rt_gbuf_normal_fmt.glsl"
#include "refl_alpha.glsl"
// rt_ReconstructWorldPos / wang_hash; contract is satisfied by depthSampler above.
#include "rt_indirect.glsl"

layout(push_constant) uniform PC {
    int   stepSize;       // 1, 2, 4, 8, … (2^iteration)
    float sigmaPlane;     // r_rtReflAtrousSigmaPlane — plane distance / view distance
    float roughnessGain;  // multiplies roughness before the mix() gate below
    float fireflyClamp;   // r_rtReflAtrousFireflyClamp — see the clamp below; 0 disables
    int   screenWidth;    // render extent — depth reconstruction and tap clamp
    int   screenHeight;
    int   scissorOffsetX;
    int   scissorOffsetY;
    int   scissorExtentX;
    int   scissorExtentY;
    int   debugMode;      // r_rtReflectionDebugMode — 14 branch view, 15 edge-stop weight
    float normalPower;    // r_rtReflAtrousNormalPower
    mat4  invViewProj;    // GL convention, as reflect_ray.rgen
} pc;

const float K[3][3] = float[3][3](
    float[3](0.0625, 0.125, 0.0625),
    float[3](0.125,  0.25,  0.125 ),
    float[3](0.0625, 0.125, 0.0625)
);

float luminance(vec3 c)
{
    return dot(c, vec3(0.2126, 0.7152, 0.0722));
}

// G-buffer shading normal, or vec3(0) at the unwritten-pixel sentinel.
vec3 DecodeNormal(ivec2 coord)
{
    ivec2 sz = textureSize(gbufNormalSampler, 0);
    vec4  g  = texelFetch(gbufNormalSampler, clamp(coord, ivec2(0), sz - 1), 0);
    return GBuf_NormalValid(g) ? GBuf_DecodeNormal(g.rg) : vec3(0.0);
}

// Geometric normal from depth, one-sided at silhouettes. The shading normal would put
// bump detail into the plane test and break up the wash on exactly the rough surfaces.
vec3 GeometricNormal(ivec2 coord, ivec2 size, vec3 pC, vec3 toCam)
{
    ivec2 hi = size - 1;
    vec3  pR = rt_ReconstructWorldPos(clamp(coord + ivec2(1, 0), ivec2(0), hi), size, pc.invViewProj);
    vec3  pL = rt_ReconstructWorldPos(clamp(coord - ivec2(1, 0), ivec2(0), hi), size, pc.invViewProj);
    vec3  pD = rt_ReconstructWorldPos(clamp(coord + ivec2(0, 1), ivec2(0), hi), size, pc.invViewProj);
    vec3  pU = rt_ReconstructWorldPos(clamp(coord - ivec2(0, 1), ivec2(0), hi), size, pc.invViewProj);
    // Take the shorter side on each axis so a silhouette neighbour doesn't tilt the plane.
    vec3  dX = (dot(pR - pC, pR - pC) < dot(pC - pL, pC - pL)) ? (pR - pC) : (pC - pL);
    vec3  dY = (dot(pD - pC, pD - pC) < dot(pC - pU, pC - pU)) ? (pD - pC) : (pC - pU);
    vec3  n  = cross(dX, dY);
    float len = length(n);
    if (len < 1e-8)
        return toCam;
    n /= len;
    return (dot(n, toCam) < 0.0) ? -n : n;
}

void main()
{
    ivec2 local = ivec2(gl_GlobalInvocationID.xy);
    ivec2 ext   = ivec2(pc.scissorExtentX, pc.scissorExtentY);

    if (local.x >= ext.x || local.y >= ext.y)
        return;

    ivec2 coord = local + ivec2(pc.scissorOffsetX, pc.scissorOffsetY);
    ivec2 size  = ivec2(pc.screenWidth, pc.screenHeight);

    if (coord.x < 0 || coord.y < 0 || coord.x >= size.x || coord.y >= size.y)
        return;

    vec4 cFull = texelFetch(reflSrc, coord, 0);

    // Debug 14: classify each pixel by the branch pass 0 takes, then later passes copy
    // it through untouched. Grey = glass, dark blue = untraced, red = roughness 0
    // (skipped), yellow = traced but no traced 3x3 neighbour (blur is a no-op),
    // green = filtered, brightness = roughness gate (share of the blurred result used).
    // Debug 15: the step-1 edge-stop weight, mean over traced neighbours. White = blends
    // freely, black = fully stopped, yellow = no traced neighbour. Untraced/glass as 14.
    bool debugEdge = (pc.debugMode == 15);
    if ((pc.debugMode == 14 || debugEdge) && pc.stepSize != 1)
    {
        imageStore(reflDst, coord, cFull);
        return;
    }

    if (pc.debugMode == 14)
    {
        vec3 vis;
        if (ReflAlpha_IsGlass(cFull.a))
            vis = vec3(0.25);
        else if (!ReflAlpha_Traced(cFull.a))
            vis = vec3(0.0, 0.0, 0.3);
        else
        {
            ivec2 aSz = textureSize(gbufAlbedoSampler, 0);
            float r   = GBuf_UnpackRoughness(texelFetch(gbufAlbedoSampler, min(coord, aSz - 1), 0).a);
            int   n   = 0;
            for (int dy = -1; dy <= 1; dy++)
                for (int dx = -1; dx <= 1; dx++)
                {
                    if (dx == 0 && dy == 0)
                        continue;
                    ivec2 s = clamp(coord + ivec2(dx, dy), ivec2(0), size - 1);
                    if (ReflAlpha_Traced(texelFetch(reflSrc, s, 0).a))
                        n++;
                }
            if (r <= 0.0)
                vis = vec3(1.0, 0.0, 0.0);
            else if (n == 0)
                vis = vec3(1.0, 1.0, 0.0);
            else
                vis = vec3(0.0, 0.15 + 0.85 * clamp(r * pc.roughnessGain, 0.0, 1.0), 0.0);
        }
        imageStore(reflDst, coord, vec4(vis, 1.0));
        return;
    }

    // Glass, sky, or a pixel that never traced (F0 too low) — nothing to denoise,
    // and (for glass) nothing this filter is allowed to touch. Pass through exactly.
    if (!ReflAlpha_Traced(cFull.a))
    {
        if (debugEdge)
            cFull = ReflAlpha_IsGlass(cFull.a) ? vec4(vec3(0.25), 1.0) : vec4(0.0, 0.0, 0.3, 1.0);
        imageStore(reflDst, coord, cFull);
        return;
    }

    ivec2 albedoSize = textureSize(gbufAlbedoSampler, 0);
    float roughness  = GBuf_UnpackRoughness(texelFetch(gbufAlbedoSampler, min(coord, albedoSize - 1), 0).a);

    // roughness 0 -> output is cFull, byte for byte. Only a genuinely rough pixel
    // pays for the 3x3 tap below, and only in proportion to how rough it is.
    if (roughness <= 0.0 && !debugEdge)
    {
        imageStore(reflDst, coord, cFull);
        return;
    }

    vec3 cCenter = cFull.rgb;

    // Centre plane, in world space. Plane distance is divided by view distance so the
    // stop means the same thing at 20 units and at 500.
    vec4  camH     = pc.invViewProj * vec4(0.0, 0.0, -1.0, 1.0);
    vec3  camPos   = camH.xyz / camH.w;
    vec3  pC       = rt_ReconstructWorldPos(coord, size, pc.invViewProj);
    float viewDist = max(length(pC - camPos), 1.0);
    vec3  nGeo     = GeometricNormal(coord, size, pC, (camPos - pC) / viewDist);
    vec3  nC       = DecodeNormal(coord);

    float invSigmaP2 = 1.0 / (pc.sigmaPlane * pc.sigmaPlane + 1e-8);

    // Gather the 3x3 once: used both for the firefly clamp below and the edge-stopped
    // blend after it, so each neighbour is only texelFetch'd once per pass.
    vec3  tapColour[9];
    float tapEdgeW[9];
    bool  tapValid[9];

    for (int dy = -1; dy <= 1; dy++)
    {
        for (int dx = -1; dx <= 1; dx++)
        {
            int idx = (dy + 1) * 3 + (dx + 1);
            ivec2 sCoord = clamp(coord + ivec2(dx, dy) * pc.stepSize, ivec2(0), size - 1);

            vec4 sFull = texelFetch(reflSrc, sCoord, 0);
            // Same exclusion as the centre test above: skip glass and untraced
            // neighbours rather than let them pull the average toward a value
            // that belongs to a different surface or isn't a reflection at all.
            tapValid[idx]  = ReflAlpha_Traced(sFull.a);
            tapColour[idx] = sFull.rgb;

            vec3  pT    = rt_ReconstructWorldPos(sCoord, size, pc.invViewProj);
            float plane = dot(pT - pC, nGeo) / viewDist;
            float wP    = exp(-plane * plane * invSigmaP2);

            // Unwritten normals (vec3(0)) don't veto; the plane stop still applies.
            vec3  nT = DecodeNormal(sCoord);
            float wN = (dot(nC, nC) > 0.0 && dot(nT, nT) > 0.0)
                           ? pow(max(dot(nC, nT), 0.0), pc.normalPower) : 1.0;

            tapEdgeW[idx] = wP * wN;
        }
    }

    if (debugEdge)
    {
        float sumW = 0.0;
        int   n    = 0;
        for (int i = 0; i < 9; i++)
        {
            if (i == 4 || !tapValid[i])
                continue;
            sumW += tapEdgeW[i];
            n++;
        }
        vec3 vis = (n == 0) ? vec3(1.0, 1.0, 0.0) : vec3(sumW / float(n));
        imageStore(reflDst, coord, vec4(vis, 1.0));
        return;
    }

    // Firefly clamp: every tap is capped at the second-brightest valid tap's luminance
    // (times fireflyClamp). A lone bright texel, centre or neighbour, drops to the next
    // brightest, so it neither survives nor bleeds into the blur. Features two or more
    // taps wide keep their level. 0 disables.
    //
    // Runs every pass with no absolute floor on purpose: limiting it to pass 0 or
    // flooring the cap left isolated white specks and outlined railings.
    if (pc.fireflyClamp > 0.0)
    {
        float max1 = -1.0;
        float max2 = -1.0;
        for (int i = 0; i < 9; i++)
        {
            if (!tapValid[i])
                continue;
            float l = luminance(tapColour[i]);
            if (l > max1)
            {
                max2 = max1;
                max1 = l;
            }
            else if (l > max2)
            {
                max2 = l;
            }
        }
        if (max2 >= 0.0)
        {
            float cap = max2 * pc.fireflyClamp;
            for (int i = 0; i < 9; i++)
            {
                float l = luminance(tapColour[i]);
                if (l > cap && l > 0.0001)
                    tapColour[i] *= cap / l;
            }
            float lc = luminance(cCenter);
            if (lc > cap && lc > 0.0001)
                cCenter *= cap / lc;
        }
    }

    // roughnessGain lets a moderately-rough surface reach full blend before
    // roughness itself hits 1.0 — roughness 0 is still excluded above, so glass
    // and screens stay untouched regardless of the gain setting.
    float gated = clamp(roughness * pc.roughnessGain, 0.0, 1.0);

    vec3  accumColour = vec3(0.0);
    float accumWeight = 0.0;

    for (int dy = -1; dy <= 1; dy++)
    {
        for (int dx = -1; dx <= 1; dx++)
        {
            int idx = (dy + 1) * 3 + (dx + 1);
            if (!tapValid[idx])
                continue;

            // Geometry stops only. A luminance stop shields bright outliers from the blur,
            // and a rough opaque reflection has no luminance edges worth keeping.
            float w = K[dy + 1][dx + 1] * tapEdgeW[idx];

            accumColour += tapColour[idx] * w;
            accumWeight += w;
        }
    }

    vec3 filtered = (accumWeight > 0.0001) ? (accumColour / accumWeight) : cCenter;
    vec3 result   = mix(cCenter, filtered, gated);
    imageStore(reflDst, coord, vec4(result, cFull.a));
}
