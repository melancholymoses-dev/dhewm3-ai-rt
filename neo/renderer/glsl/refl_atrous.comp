/*
===========================================================================

dhewm3-rt Vulkan — refl_atrous.comp — roughness-gated À-trous spatial filter
for RT reflections (Stage 1 addendum, docs/plans/20261013_reflection_roughness.md,
r_rtReflDenoise 2).

Same B3-spline À-trous pattern as gi_atrous.comp (N compute passes, step width
doubling each iteration, depth + luminance edge-stopping) run on top of the
temporal resolve's output, but gated per pixel by Stage 2's packed roughness:
the filtered and unfiltered colours are mixed by `roughness * roughnessGain`
(r_rtReflAtrousRoughnessGain), so a roughness-0 pixel (glass-sharp trim, GUI
screens) is still output byte-for-byte unchanged, but the gain lets everything
above that reach a full wash sooner than roughness alone would. This is what
keeps a polished-metal reflection crisp while washing out the grain on a rough
painted panel next to it.

Glass pixels (negative alpha sentinel, see reflect_ray.rgen) are passed through
untouched and never contribute as a neighbour sample: glass is hardcoded to
roughness 0 structurally (Stage 3) and belongs to a different surface than the
opaque geometry this filter reasons about. Untraced/non-reflective pixels
(alpha <= 1/255, the same threshold reflect_ray.rgen's own F0 early-out uses)
are excluded the same way — both as centres (nothing to denoise) and as
neighbour samples (blending one in would paint a reflection onto a surface
that was deliberately culled for having no F0).

A local firefly clamp (r_rtReflAtrousFireflyClamp) runs before the blend: a single
GGX sample with no light importance sampling occasionally points straight at
something much brighter than its surroundings. Every tap is capped at the 3x3's
second-brightest luminance, which removes lone texels outright. The luminance
edge-stop fades out with roughness so rough surfaces get a plain depth-stopped wash.

Inputs (set 0):
  binding 0 (combined image sampler)          — reflection buffer for this pass (ping-pong)
  binding 1 (rgba16f, storage, GENERAL)        — output reflection buffer for this pass
  binding 2 (combined image sampler)           — scene depth buffer
  binding 3 (combined image sampler)           — gbufAlbedo (alpha = packed class + roughness)

Push constants: 44 bytes — gi_atrous.comp's PC block plus a trailing fireflyClamp float.

This file is a new addition with dhewm3-rt.  It was created with the aid of GenAI,
and may reference the existing Dhewm3 OpenGL and vkDoom3 Vulkan updates of the Doom 3 GPL Source
Code.

It is distributed under the same modified GNU General Public License Version 3 of the original Doom 3 GPL Source
Code release.

===========================================================================
*/

#version 460

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D reflSrc;
layout(set = 0, binding = 1, rgba16f) uniform image2D reflDst;
layout(set = 0, binding = 2) uniform sampler2D depthSampler;
layout(set = 0, binding = 3) uniform sampler2D gbufAlbedoSampler;

#include "gbuf_albedo_class.glsl"

layout(push_constant) uniform PC {
    int   stepSize;       // 1, 2, 4, 8, … (2^iteration)
    float sigmaL;         // luminance edge-stop bandwidth
    float sigmaZ;         // depth edge-stop bandwidth
    float roughnessGain;  // multiplies roughness before the mix() gate below
    int   screenWidth;
    int   screenHeight;
    int   scissorOffsetX;
    int   scissorOffsetY;
    int   scissorExtentX;
    int   scissorExtentY;
    float fireflyClamp;   // r_rtReflAtrousFireflyClamp — see the clamp below; 0 disables
} pc;

const float K[3][3] = float[3][3](
    float[3](0.0625, 0.125, 0.0625),
    float[3](0.125,  0.25,  0.125 ),
    float[3](0.0625, 0.125, 0.0625)
);

float luminance(vec3 c)
{
    return dot(c, vec3(0.2126, 0.7152, 0.0722));
}

// Same threshold reflect_ray.rgen's own F0 early-out uses: anything at or below
// this never traced a reflection ray (glass's own negative sentinel also fails
// this test, same comparison direction).
const float VALID_ALPHA_THRESHOLD = 1.0 / 255.0;

void main()
{
    ivec2 local = ivec2(gl_GlobalInvocationID.xy);
    ivec2 ext   = ivec2(pc.scissorExtentX, pc.scissorExtentY);

    if (local.x >= ext.x || local.y >= ext.y)
        return;

    ivec2 coord = local + ivec2(pc.scissorOffsetX, pc.scissorOffsetY);
    ivec2 size  = ivec2(pc.screenWidth, pc.screenHeight);

    if (coord.x < 0 || coord.y < 0 || coord.x >= size.x || coord.y >= size.y)
        return;

    vec4 cFull = texelFetch(reflSrc, coord, 0);

    // Glass, sky, or a pixel that never traced (F0 too low) — nothing to denoise,
    // and (for glass) nothing this filter is allowed to touch. Pass through exactly.
    if (cFull.a <= VALID_ALPHA_THRESHOLD)
    {
        imageStore(reflDst, coord, cFull);
        return;
    }

    ivec2 albedoSize = textureSize(gbufAlbedoSampler, 0);
    float roughness  = GBuf_UnpackRoughness(texelFetch(gbufAlbedoSampler, min(coord, albedoSize - 1), 0).a);

    // roughness 0 -> output is cFull, byte for byte. Only a genuinely rough pixel
    // pays for the 3x3 tap below, and only in proportion to how rough it is.
    if (roughness <= 0.0)
    {
        imageStore(reflDst, coord, cFull);
        return;
    }

    vec3  cCenter = cFull.rgb;
    float dCenter = texelFetch(depthSampler, coord, 0).r;

    float sigmaL2 = pc.sigmaL * pc.sigmaL + 0.0001;
    float sigmaZ2 = pc.sigmaZ * pc.sigmaZ + 0.0001;

    // Gather the 3x3 once: used both for the firefly clamp below and the edge-stopped
    // blend after it, so each neighbour is only texelFetch'd once per pass.
    vec3  tapColour[9];
    float tapDepth[9];
    bool  tapValid[9];

    for (int dy = -1; dy <= 1; dy++)
    {
        for (int dx = -1; dx <= 1; dx++)
        {
            int idx = (dy + 1) * 3 + (dx + 1);
            ivec2 sCoord = clamp(coord + ivec2(dx, dy) * pc.stepSize, ivec2(0), size - 1);

            vec4 sFull = texelFetch(reflSrc, sCoord, 0);
            // Same exclusion as the centre test above: skip glass and untraced
            // neighbours rather than let them pull the average toward a value
            // that belongs to a different surface or isn't a reflection at all.
            tapValid[idx]  = sFull.a > VALID_ALPHA_THRESHOLD;
            tapColour[idx] = sFull.rgb;
            tapDepth[idx]  = texelFetch(depthSampler, sCoord, 0).r;
        }
    }

    // Firefly clamp: every tap is capped at the second-brightest valid tap's luminance
    // (times fireflyClamp). A lone bright texel, centre or neighbour, drops to the next
    // brightest, so it neither survives nor bleeds into the blur. Features two or more
    // taps wide keep their level. 0 disables.
    //
    // Runs every pass with no absolute floor on purpose: limiting it to pass 0 or
    // flooring the cap left isolated white specks and outlined railings.
    if (pc.fireflyClamp > 0.0)
    {
        float max1 = -1.0;
        float max2 = -1.0;
        for (int i = 0; i < 9; i++)
        {
            if (!tapValid[i])
                continue;
            float l = luminance(tapColour[i]);
            if (l > max1)
            {
                max2 = max1;
                max1 = l;
            }
            else if (l > max2)
            {
                max2 = l;
            }
        }
        if (max2 >= 0.0)
        {
            float cap = max2 * pc.fireflyClamp;
            for (int i = 0; i < 9; i++)
            {
                float l = luminance(tapColour[i]);
                if (l > cap && l > 0.0001)
                    tapColour[i] *= cap / l;
            }
            float lc = luminance(cCenter);
            if (lc > cap && lc > 0.0001)
                cCenter *= cap / lc;
        }
    }

    float lCenter = luminance(cCenter);

    // roughnessGain lets a moderately-rough surface reach full blend before
    // roughness itself hits 1.0 — roughness 0 is still excluded above, so glass
    // and screens stay untouched regardless of the gain setting.
    float gated = clamp(roughness * pc.roughnessGain, 0.0, 1.0);

    vec3  accumColour = vec3(0.0);
    float accumWeight = 0.0;

    for (int dy = -1; dy <= 1; dy++)
    {
        for (int dx = -1; dx <= 1; dx++)
        {
            int idx = (dy + 1) * 3 + (dx + 1);
            if (!tapValid[idx])
                continue;

            vec3  sColour = tapColour[idx];
            float sDepth  = tapDepth[idx];

            float dl = lCenter - luminance(sColour);
            // Fades out with roughness: a rough reflection has no edges worth keeping,
            // and the stop would otherwise shield any bright outlier from the blur.
            float wL = mix(exp(-(dl * dl) / sigmaL2), 1.0, gated);

            float dd = dCenter - sDepth;
            float wD = exp(-(dd * dd) / sigmaZ2);

            float w = K[dy + 1][dx + 1] * wL * wD;

            accumColour += sColour * w;
            accumWeight += w;
        }
    }

    vec3 filtered = (accumWeight > 0.0001) ? (accumColour / accumWeight) : cCenter;
    vec3 result   = mix(cCenter, filtered, gated);
    imageStore(reflDst, coord, vec4(result, cFull.a));
}
